@import "tailwindcss";
@import "tw-animate-css";

@source "../src";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --radius-sm: var(--radius-sm);
  --radius-md: var(--radius-md);
  --radius-lg: var(--radius-lg);
  --radius-xl: var(--radius-xl);
  --radius-pill: var(--radius-pill);

  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-ink: var(--ink);
  --color-surface: var(--surface);
  --color-ivory: var(--ivory);
  --color-gold: var(--gold);
  --color-green: var(--green);
  --color-brand-dark: var(--brand-dark);
  --color-brand-teal: var(--brand-teal);
  --color-brand-teal-light: var(--brand-teal-light);

  --font-display: "Fraunces", Georgia, "Times New Roman", serif;
  --font-body: "Hanken Grotesk", "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-ui: "Hanken Grotesk", "Inter", ui-sans-serif, system-ui, sans-serif;
  /* Map Tailwind's font-serif / font-sans utilities to the brand fonts */
  --font-serif: "Fraunces", Georgia, "Times New Roman", serif;
  --font-sans: "Hanken Grotesk", "Inter", ui-sans-serif, system-ui, sans-serif;
}

:root {
  /* Radius scale — one language for every card/control on the site.
     sm: chips & small controls · md: buttons/inputs · lg: inner media ·
     xl: standard cards · card: hero/feature cards */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-card: 24px;
  --radius-card-lg: 28px;
  --radius-pill: 999px;

  --background: #f6f3ee;
  --foreground: #111111;
  --card: #faf8f4;
  --card-foreground: #111111;
  --popover: #faf8f4;
  --popover-foreground: #111111;
  --primary: #8bc540;
  --primary-foreground: #ffffff;
  --secondary: #2f5218;
  --secondary-foreground: #f5f2ec;
  --muted: #f0ede6;
  --muted-foreground: #202020;
  --accent: #c8a96b;
  --accent-foreground: #111111;
  --destructive: #c25757;
  --destructive-foreground: #ffffff;
  --border: rgba(139, 197, 64, 0.14);
  --input: rgba(139, 197, 64, 0.18);
  --ring: rgba(139, 197, 64, 0.24);

  --ink: #2f5218;
  --surface: #faf8f4;
  --ivory: #f6f3ee;
  --gold: #c8a96b;
  --green: #8bc540;
  --green-soft: #73a832;
  --green-highlight: #a8d95a;
  --green-deep: #234a14;
  --warm-gray: #f0ede6;
  --brand-dark: #2f5218;
  --brand-teal: #8bc540;
  --brand-teal-light: #a8d95a;
  --text-soft: #202020;
  --text-muted: #242424;
  /* Shadow language — warm neutral ink, one family for all cards */
  --shadow-soft: 0 14px 40px -30px rgb(23 25 28 / 0.14);
  --shadow-card: 0 24px 64px -42px rgb(23 25 28 / 0.18);
  --shadow-card-hover:
    0 34px 80px -44px rgb(23 25 28 / 0.24), 0 0 40px -14px rgb(139 197 64 / 0.14);
  --shadow-dark: 0 28px 72px -42px rgb(17 19 21 / 0.4);
  --container-width: 1536px;
  --space-section-sm: 5rem;
  --space-section-lg: 8rem;
  /* Luxury motion is slower — interactions breathe instead of snap */
  --motion-fast: 200ms;
  --motion-normal: 320ms;
  --motion-premium: 500ms;
  --motion-luxury: 750ms;
  --ease-precise: cubic-bezier(0.35, 0, 0.15, 1);
  --ease-premium: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-soft: cubic-bezier(0.16, 1, 0.3, 1);
  --transition-luxe: cubic-bezier(0.22, 1, 0.36, 1);
  /* Alias used by a few legacy components — same as display */
  --font-heading: "Fraunces", Georgia, "Times New Roman", serif;
}

@layer base {
  * {
    border-color: var(--border);
  }

  html {
    scroll-behavior: smooth;
    overflow-x: clip;
    overflow-y: auto;
    scrollbar-color: #8bc540 transparent;
    scrollbar-width: thin;
  }

  body {
    background: linear-gradient(180deg, #ffffff 0%, #f6f3ee 46%, #f3f9eb 100%);
    color: var(--foreground);
    font-family: var(--font-body);
    font-weight: 300;
    overflow-x: clip;
    overflow-y: visible;
    font-feature-settings: "ss01", "cv11", "salt";
    letter-spacing: 0;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--foreground);
  }

  h1 {
    font-size: clamp(3.35rem, 5.4vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: clamp(2.35rem, 3.9vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  h3 {
    font-size: clamp(1.95rem, 3vw, 2.25rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  h4 {
    font-size: clamp(1.55rem, 2.4vw, 1.75rem);
    line-height: 1.25;
  }

  h5 {
    font-size: 1.375rem;
    line-height: 1.3;
  }

  h6 {
    font-size: 1.125rem;
    line-height: 1.4;
  }

  p,
  li,
  input,
  textarea,
  select,
  option,
  label {
    font-family: var(--font-body);
  }

  p {
    font-size: 1rem;
    line-height: 1.7;
    font-weight: 300;
    color: var(--text-soft);
  }

  button,
  [role="button"] {
    font-family: var(--font-ui);
    font-weight: 400;
    font-size: 0.8125rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  a,
  button {
    transition:
      color var(--motion-normal) var(--ease-premium),
      background-color var(--motion-normal) var(--ease-premium),
      border-color var(--motion-normal) var(--ease-premium),
      box-shadow var(--motion-premium) var(--ease-premium),
      transform var(--motion-premium) var(--ease-premium),
      opacity var(--motion-normal) var(--ease-premium),
      filter var(--motion-premium) var(--ease-premium);
  }

  :focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--ring);
  }

  ::selection {
    background-color: var(--accent);
    color: var(--ivory);
  }

  ::-webkit-scrollbar {
    width: 3px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: #8bc540;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 1ms !important;
      scroll-behavior: auto !important;
    }
  }
}

@layer components {
  .font-serif {
    font-family: var(--font-display);
  }

  .site-container {
    width: min(calc(100% - 2rem), var(--container-width));
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .site-container {
      width: min(calc(100% - 8rem), var(--container-width));
    }
  }

  .section-shell {
    padding-block: clamp(4.5rem, 9vw, var(--space-section-sm));
  }

  @media (min-width: 768px) {
    .section-shell {
      padding-block: var(--space-section-lg);
    }
  }

  .eyebrow {
    font-size: 0.6875rem;
    line-height: 1.2;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--accent);
  }

  .display-xl {
    font-family: var(--font-display);
    font-size: clamp(3.35rem, 5.4vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--foreground);
    text-wrap: balance;
  }

  .hero-display {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 4.2vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.038em;
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: manual;
    word-break: normal;
    text-shadow: 0 20px 48px rgb(7 17 27 / 0.24);
  }

  /* Long Dutch compounds ("Keukenbestemming") must fit small screens */
  @media (max-width: 767px) {
    .hero-display {
      font-size: clamp(2.1rem, 9.4vw, 3rem);
      line-height: 1.02;
      letter-spacing: -0.03em;
    }
  }

  .hero-accent {
    font-style: italic;
    font-size: 1.03em;
    letter-spacing: -0.03em;
    color: transparent;
    background-image: linear-gradient(180deg, #c5e88a 0%, #a8d95a 28%, #8bc540 68%, #73a832 100%);
    background-size: 100% 160%;
    background-position: 50% 22%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 1px rgb(47 82 24 / 0.18);
    filter: drop-shadow(0 14px 36px rgb(7 17 27 / 0.18));
    text-shadow:
      0 18px 44px rgb(7 17 27 / 0.18),
      0 1px 0 rgb(255 255 255 / 0.06);
    position: relative;
  }

  .hero-accent::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 0%,
      rgb(255 255 255 / 0.14) 42%,
      transparent 62%
    );
    opacity: 0.42;
    mix-blend-mode: soft-light;
  }

  .hero-scroll-cue-frame {
    border: 1px solid rgba(247, 245, 242, 0.28);
    border-bottom: none;
    border-radius: 5px 5px 0 0;
    background: rgba(23, 25, 28, 0.18);
    backdrop-filter: blur(8px);
    transition:
      border-color var(--motion-premium) var(--ease-premium),
      background-color var(--motion-premium) var(--ease-premium);
  }

  .hero-scroll-cue-glow {
    background: radial-gradient(circle, rgba(139, 197, 64, 0.22) 0%, transparent 70%);
  }

  /* Kitchen ornament next to the hero eyebrow */
  .hero-eyebrow-ornament {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .hero-eyebrow-ornament__icon {
    filter: drop-shadow(0 2px 8px rgb(7 17 27 / 0.35));
  }

  .hero-scroll-cue--compact .hero-scroll-cue-frame {
    padding: 0.45rem 0.85rem;
  }

  .hero-scroll-cue:hover .hero-scroll-cue-frame,
  .hero-scroll-cue:focus-visible .hero-scroll-cue-frame {
    border-color: rgba(139, 197, 64, 0.42);
    background: rgba(23, 25, 28, 0.24);
  }

  .heading-1,
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(3.35rem, 5.4vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--secondary);
    text-wrap: balance;
  }

  .heading-2 {
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 3.9vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--secondary);
    text-wrap: balance;
  }

  @media (max-width: 767px) {
    .heading-1,
    .section-title {
      font-size: clamp(2.4rem, 10vw, 3.4rem);
      line-height: 1.02;
      letter-spacing: -0.04em;
    }

    .heading-2 {
      font-size: clamp(2rem, 8vw, 2.65rem);
      line-height: 1.05;
      letter-spacing: -0.03em;
    }

    .body-lg {
      font-size: 1.03rem;
      line-height: 1.72;
    }

    .body-md,
    .section-description {
      font-size: 0.98rem;
      line-height: 1.75;
    }

    .section-label-row {
      gap: 0.8rem;
      margin-bottom: 1rem;
    }
  }

  .heading-3 {
    font-family: var(--font-display);
    font-size: clamp(1.95rem, 3vw, 2.25rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }

  .body-lg {
    font-size: 1.125rem;
    line-height: 1.6;
    font-weight: 300;
    color: var(--text-soft);
  }

  .body-md,
  .section-description {
    font-size: 1rem;
    line-height: 1.7;
    font-weight: 300;
    color: var(--text-soft);
  }

  .small-text {
    font-size: 0.875rem;
    line-height: 1.65;
    font-weight: 300;
    color: var(--text-muted);
  }

  .caption-text {
    font-size: 0.6875rem;
    line-height: 1.3;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .section-label-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .section-header-split {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  @media (min-width: 900px) {
    .section-header-split {
      grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.55fr);
    }
  }

  .brand-green-button,
  .btn-primary,
  .btn-secondary,
  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 3.5rem;
    padding: 0.95rem 2rem;
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid transparent;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition:
      transform var(--motion-premium) var(--ease-premium),
      box-shadow var(--motion-premium) var(--ease-premium),
      background-color var(--motion-premium) var(--ease-premium),
      border-color var(--motion-normal) var(--ease-premium),
      color var(--motion-normal) var(--ease-premium);
  }

  .brand-green-button svg,
  .btn-primary svg,
  .btn-secondary svg,
  .btn-outline svg {
    transition: transform var(--motion-premium) var(--ease-precise);
  }

  .brand-green-button:hover svg,
  .btn-primary:hover svg,
  .btn-secondary:hover svg,
  .btn-outline:hover svg {
    transform: translateX(3px);
  }

  .brand-green-button,
  .btn-primary {
    background: linear-gradient(180deg, #9ccd4a 0%, #689a2e 100%);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 20px -8px rgba(139, 197, 64, 0.32);
    isolation: isolate;
  }

  .brand-green-button > *,
  .btn-primary > * {
    position: relative;
    z-index: 1;
  }

  .brand-green-button::before,
  .btn-primary::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: transparent;
    pointer-events: none;
    opacity: 0;
  }

  .brand-green-button::after,
  .btn-primary::after {
    content: "";
    position: absolute;
    top: -120%;
    bottom: -120%;
    left: -28%;
    width: 26%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgb(255 255 255 / 0.22) 52%,
      transparent 100%
    );
    transform: rotate(18deg) translateX(-220%);
    transition: transform var(--motion-luxury) var(--ease-premium);
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .brand-green-button:hover,
  .btn-primary:hover {
    transform: translate3d(0, -2px, 0) scale(1.02);
    background: linear-gradient(168deg, #a8d95a 0%, #9ccd4a 38%, #8bc540 100%);
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.22) inset,
      0 -1px 0 0 rgba(0, 0, 0, 0.08) inset,
      0 16px 36px -8px rgba(139, 197, 64, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.08) inset;
  }

  .brand-green-button:hover::after,
  .btn-primary:hover::after {
    transform: rotate(18deg) translateX(520%);
  }

  /* ── Premium pill CTA (badge circle + luxury hover) ─────────────── */
  .premium-pill-button {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    justify-content: flex-start;
    gap: 0.55rem;
    padding: 0.22rem 0.28rem 0.22rem 0.95rem;
    border-radius: 9999px;
    border: 1px solid transparent;
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    white-space: nowrap;
    transition:
      transform var(--motion-premium) var(--ease-premium),
      box-shadow var(--motion-premium) var(--ease-premium),
      background var(--motion-premium) var(--ease-premium),
      border-color var(--motion-normal) var(--ease-premium),
      color var(--motion-normal) var(--ease-premium);
  }

  .premium-pill-button--rounded {
    border-radius: 10px;
    padding: 0.28rem 0.32rem 0.28rem 1rem;
  }

  .premium-pill-button--sm {
    padding: 0.18rem 0.22rem 0.18rem 0.85rem;
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    gap: 0.45rem;
  }

  .premium-pill-button--sm .premium-pill-button__badge {
    width: 1.65rem;
    height: 1.65rem;
  }

  .premium-pill-button--sm .premium-pill-button__icon {
    width: 0.72rem;
    height: 0.72rem;
  }

  .premium-pill-button--md {
    padding: 0.22rem 0.28rem 0.22rem 0.95rem;
    font-size: 0.625rem;
  }

  .premium-pill-button--md .premium-pill-button__badge {
    width: 1.85rem;
    height: 1.85rem;
  }

  .premium-pill-button--md .premium-pill-button__icon {
    width: 0.78rem;
    height: 0.78rem;
  }

  .premium-pill-button--lg {
    padding: 0.26rem 0.32rem 0.26rem 1.05rem;
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
  }

  .premium-pill-button--lg .premium-pill-button__badge {
    width: 2rem;
    height: 2rem;
  }

  .premium-pill-button--lg .premium-pill-button__icon {
    width: 0.85rem;
    height: 0.85rem;
  }

  .premium-pill-button--xl {
    padding: 0.34rem 0.38rem 0.34rem 1.15rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    gap: 0.65rem;
  }

  .premium-pill-button--xl .premium-pill-button__badge {
    width: 2.25rem;
    height: 2.25rem;
  }

  .premium-pill-button--xl .premium-pill-button__icon {
    width: 0.9rem;
    height: 0.9rem;
  }

  .premium-pill-button--rounded.premium-pill-button--xl {
    border-radius: 12px;
    padding: 0.38rem 0.42rem 0.38rem 1.25rem;
  }

  .premium-pill-button__label {
    position: relative;
    z-index: 1;
    padding-right: 0;
  }

  .premium-pill-button__badge {
    position: relative;
    z-index: 1;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 9999px;
    background: #2f5218;
    color: #f8f6f2;
    transition:
      transform var(--motion-premium) var(--ease-premium),
      box-shadow var(--motion-premium) var(--ease-premium),
      background-color var(--motion-normal) var(--ease-premium);
  }

  .premium-pill-button__icon {
    width: 0.78rem;
    height: 0.78rem;
    transition: transform var(--motion-premium) var(--ease-precise);
  }

  .premium-pill-button::after {
    content: "";
    position: absolute;
    top: -120%;
    bottom: -120%;
    left: -28%;
    width: 26%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgb(255 255 255 / 0.24) 52%,
      transparent 100%
    );
    transform: rotate(18deg) translateX(-220%);
    transition: transform var(--motion-luxury) var(--ease-premium);
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .premium-pill-button--blue {
    background: linear-gradient(135deg, #a8d95a 0%, #8bc540 52%, #689a2e 100%);
    color: #ffffff;
    box-shadow: 0 10px 24px -14px rgb(139 197 64 / 0.42);
  }

  .premium-pill-button--blue .premium-pill-button__badge {
    background: #2f5218;
    color: #f8f6f2;
  }

  .premium-pill-button--ghost {
    background: rgb(23 25 28 / 0.38);
    border-color: rgb(247 245 242 / 0.16);
    color: #f7f5f2;
    backdrop-filter: blur(12px);
    box-shadow: 0 18px 46px -36px rgb(23 25 28 / 0.42);
  }

  .premium-pill-button--ghost-light {
    background: transparent;
    border-color: rgb(23 25 28 / 0.12);
    color: rgb(17 17 17 / 0.72);
    box-shadow: none;
  }

  .premium-pill-button--ghost-light .premium-pill-button__badge {
    background: #2f5218;
    color: #f8f6f2;
  }

  .premium-pill-button:hover:not(:disabled) {
    transform: translate3d(0, -1px, 0) scale(1.015);
  }

  .premium-pill-button:hover:not(:disabled)::after {
    transform: rotate(18deg) translateX(520%);
  }

  .premium-pill-button:hover:not(:disabled) .premium-pill-button__badge {
    transform: scale(1.08);
    box-shadow:
      0 0 0 4px rgb(255 255 255 / 0.08),
      0 10px 24px -12px rgb(23 25 28 / 0.45);
  }

  .premium-pill-button:hover:not(:disabled) .premium-pill-button__icon {
    transform: translateX(3px);
  }

  .premium-pill-button--blue:hover:not(:disabled) {
    background: linear-gradient(135deg, #b8e06a 0%, #9ccd4a 52%, #8bc540 100%);
    box-shadow: 0 14px 32px -12px rgb(139 197 64 / 0.5);
  }

  .premium-pill-button--ghost:hover:not(:disabled) {
    background: rgb(23 25 28 / 0.52);
    border-color: rgb(247 245 242 / 0.24);
  }

  .premium-pill-button--ghost-light:hover:not(:disabled) {
    background: rgb(248 246 242 / 0.72);
    border-color: rgb(139 197 64 / 0.28);
    color: #2f5218;
  }

  .premium-pill-button:active:not(:disabled) {
    transform: translate3d(0, 0, 0) scale(0.985);
  }

  .premium-pill-button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .premium-pill-button:disabled:hover {
    transform: none;
  }

  /* Homepage section CTAs — white bottom-up wipe. The hero (#top) is excluded. */
  .home-page :where(section:not(#top), footer) .premium-pill-button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, #ffffff 0%, #f4f2eb 100%);
    transform: translateY(105%);
    transition: transform 0.58s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .home-page :where(section:not(#top), footer) .premium-pill-button:hover:not(:disabled),
  .home-page :where(section:not(#top), footer) .premium-pill-button:focus-visible:not(:disabled) {
    color: #192012;
    border-color: rgb(255 255 255 / 0.72);
    transform: translate3d(0, -2px, 0) scale(1.025);
    box-shadow:
      0 18px 38px -10px rgb(0 0 0 / 0.38),
      0 0 0 1px rgb(255 255 255 / 0.22),
      inset 0 1px 0 rgb(255 255 255 / 0.86);
  }

  .home-page :where(section:not(#top), footer) .premium-pill-button:hover:not(:disabled)::before,
  .home-page
    :where(section:not(#top), footer)
    .premium-pill-button:focus-visible:not(:disabled)::before {
    transform: translateY(0);
  }

  .home-page
    :where(section:not(#top), footer)
    .premium-pill-button:hover:not(:disabled)
    .premium-pill-button__badge,
  .home-page
    :where(section:not(#top), footer)
    .premium-pill-button:focus-visible:not(:disabled)
    .premium-pill-button__badge {
    background: #192f0d;
    color: #ffffff;
    transform: rotate(-8deg) scale(1.08);
    box-shadow: 0 6px 16px -5px rgb(0 0 0 / 0.48);
  }

  .home-page :where(section:not(#top), footer) .premium-pill-button--ghost-light::before {
    background: linear-gradient(180deg, #9fd252 0%, #79b735 100%);
  }

  .home-page
    :where(section:not(#top), footer)
    .premium-pill-button--ghost-light:hover:not(:disabled),
  .home-page
    :where(section:not(#top), footer)
    .premium-pill-button--ghost-light:focus-visible:not(:disabled) {
    color: #ffffff;
    border-color: rgb(139 197 64 / 0.72);
    box-shadow:
      0 18px 38px -10px rgb(83 126 34 / 0.5),
      0 0 0 1px rgb(197 232 138 / 0.22),
      inset 0 1px 0 rgb(255 255 255 / 0.36);
  }

  /* ── Collection gallery cards ─────────────────────────────────────────── */
  .collection-gallery-card {
    --card-gold: rgba(200, 169, 107, 0.72);
    --card-gold-bright: rgba(212, 184, 120, 0.95);
    --card-teal: rgba(139, 197, 64, 0.55);
    position: relative;
    display: block;
    height: 100%;
    overflow: visible;
    border-radius: 22px;
    background: #0c1014;
    border: 1px solid rgb(200 169 107 / 0.22);
    box-shadow:
      0 14px 42px -18px rgb(0 0 0 / 0.62),
      inset 0 1px 0 rgb(255 255 255 / 0.04);
    transform: translate3d(0, 0, 0);
    transition:
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.5s ease;
    will-change: transform;
  }

  .collection-gallery-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 4;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.04);
    transition: box-shadow 0.55s ease;
  }

  .collection-gallery-card:hover {
    transform: translate3d(0, -14px, 0) scale(1.025);
    border-color: rgb(200 169 107 / 0.58);
    box-shadow:
      0 28px 70px -22px rgb(0 0 0 / 0.72),
      0 0 0 1px rgb(139 197 64 / 0.14),
      0 18px 48px -16px rgb(139 197 64 / 0.22);
  }

  .collection-gallery-card:hover::before {
    box-shadow:
      inset 0 0 0 1px rgb(200 169 107 / 0.18),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
  }

  .collection-gallery-card__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 21px;
  }

  .collection-gallery-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-gallery-card:hover .collection-gallery-card__media img {
    transform: scale(1.12);
  }

  .collection-gallery-card__media-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 0.12) 0%,
      transparent 34%,
      transparent 52%,
      rgb(12 16 20 / 0.18) 72%,
      rgb(12 16 20 / 0.42) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  .collection-gallery-card__media-hover-fade {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      180deg,
      rgb(22 56 71 / 0.12) 0%,
      rgb(0 0 0 / 0.18) 38%,
      rgb(12 16 20 / 0.62) 78%,
      rgb(12 16 20 / 0.88) 100%
    );
    transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-gallery-card:hover .collection-gallery-card__media-hover-fade {
    opacity: 1;
  }

  .collection-gallery-card__shine {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 38%,
      rgb(255 255 255 / 0.16) 50%,
      transparent 62%
    );
    transform: translateX(-120%) skewX(-12deg);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-gallery-card:hover .collection-gallery-card__shine {
    transform: translateX(120%) skewX(-12deg);
  }

  .collection-gallery-card__badges {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1rem 1rem 0;
    pointer-events: none;
  }

  .collection-gallery-card__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.35rem;
    height: 1.65rem;
    padding: 0 0.55rem;
    border-radius: 999px;
    background: rgb(12 16 20 / 0.78);
    border: 1px solid rgb(255 255 255 / 0.08);
    backdrop-filter: blur(8px);
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 300;
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 0.92);
    transition:
      background 0.45s ease,
      border-color 0.45s ease,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-gallery-card:hover .collection-gallery-card__number {
    background: rgb(22 56 71 / 0.88);
    border-color: rgb(200 169 107 / 0.28);
    transform: translateY(-2px);
  }

  .collection-gallery-card__tag {
    padding: 0.38rem 0.72rem;
    border-radius: 999px;
    background: rgb(12 16 20 / 0.78);
    border: 1px solid rgb(200 169 107 / 0.18);
    backdrop-filter: blur(8px);
    font-family: var(--font-body);
    font-size: 0.48rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--card-gold);
    transition:
      color 0.45s ease,
      border-color 0.45s ease,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-gallery-card:hover .collection-gallery-card__tag {
    color: var(--card-gold-bright);
    border-color: rgb(200 169 107 / 0.42);
    transform: translateY(-2px);
  }

  .collection-gallery-card__body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.35rem 1.25rem 2.45rem;
    border-radius: 0 0 21px 21px;
    background: linear-gradient(
      180deg,
      rgb(12 16 20 / 0) 0%,
      rgb(12 16 20 / 0.42) 24%,
      rgb(12 16 20 / 0.9) 52%,
      #0f151b 100%
    );
    transition: background 0.55s ease;
  }

  .collection-gallery-card:hover .collection-gallery-card__body {
    background: linear-gradient(
      180deg,
      rgb(12 16 20 / 0) 0%,
      rgb(12 16 20 / 0.48) 24%,
      rgb(14 20 26 / 0.94) 52%,
      #111920 100%
    );
  }

  .collection-gallery-card__title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--card-gold-bright);
    transition: color 0.45s ease;
  }

  .collection-gallery-card:hover .collection-gallery-card__title {
    color: #e8d4a8;
  }

  .collection-gallery-card__descriptor {
    margin-top: 0.32rem;
    font-family: var(--font-body);
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(200 169 107 / 0.62);
    transition: color 0.45s ease;
  }

  .collection-gallery-card:hover .collection-gallery-card__descriptor {
    color: rgb(200 169 107 / 0.88);
  }

  .collection-gallery-card__description {
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 300;
    line-height: 1.48;
    color: rgb(255 255 255 / 0.62);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.45s ease;
  }

  .collection-gallery-card:hover .collection-gallery-card__description {
    color: rgb(255 255 255 / 0.82);
  }

  .collection-gallery-card__rule {
    width: 100%;
    height: 1px;
    margin-top: 0.5rem;
    background: linear-gradient(90deg, rgb(200 169 107 / 0.55), rgb(139 197 64 / 0.28));
    transition: background 0.45s ease;
  }

  .collection-gallery-card:hover .collection-gallery-card__rule {
    background: linear-gradient(90deg, rgb(200 169 107 / 0.85), rgb(139 197 64 / 0.45));
  }

  .collection-gallery-card__cta-wrap {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 6;
    width: max-content;
    max-width: calc(100% - 3rem);
    transform: translateX(-50%) translateY(50%);
    display: flex;
    justify-content: center;
    pointer-events: auto;
    opacity: 1;
    filter: drop-shadow(0 8px 18px rgb(139 197 64 / 0.32));
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-gallery-card:hover .collection-gallery-card__cta-wrap {
    transform: translateX(-50%) translateY(calc(50% - 4px)) scale(1.03);
  }

  .collection-gallery-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem;
    width: auto;
    min-width: 9.25rem;
    padding: 0.36rem 0.42rem 0.36rem 0.95rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.14);
    background: linear-gradient(135deg, #a8d95a 0%, #8bc540 52%, #689a2e 100%);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      0 10px 26px -12px rgb(139 197 64 / 0.55),
      inset 0 1px 0 rgb(255 255 255 / 0.2);
    overflow: hidden;
    isolation: isolate;
    position: relative;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.45s ease,
      background 0.45s ease;
  }

  .collection-gallery-card__cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, #ffffff 0%, #f4f2eb 100%);
    transform: translateY(105%);
    transition: transform 0.58s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .collection-gallery-card__cta > span {
    position: relative;
    z-index: 1;
  }

  .collection-gallery-card__cta::after {
    content: "";
    position: absolute;
    top: -120%;
    left: -40%;
    width: 42%;
    height: 320%;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.32), transparent);
    transform: rotate(18deg) translateX(-520%);
    transition: transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-gallery-card__cta:hover,
  .collection-gallery-card__cta:focus-visible {
    color: #192012;
    transform: translateY(-2px) scale(1.03);
    border-color: rgb(255 255 255 / 0.72);
    box-shadow:
      0 18px 38px -10px rgb(0 0 0 / 0.42),
      0 0 0 1px rgb(255 255 255 / 0.2),
      inset 0 1px 0 rgb(255 255 255 / 0.84);
  }

  .collection-gallery-card__cta:hover::before,
  .collection-gallery-card__cta:focus-visible::before {
    transform: translateY(0);
  }

  .collection-gallery-card__cta:hover::after {
    transform: rotate(18deg) translateX(520%);
  }

  .collection-gallery-card__cta-badge {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.38rem;
    height: 1.38rem;
    border-radius: 999px;
    background: #2f5218;
    border: 1px solid rgb(255 255 255 / 0.14);
    color: #f8f6f2;
    overflow: hidden;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.45s ease;
  }

  .collection-gallery-card__cta:hover .collection-gallery-card__cta-badge,
  .collection-gallery-card__cta:focus-visible .collection-gallery-card__cta-badge {
    transform: rotate(-8deg) scale(1.08);
    background: #192f0d;
    color: #ffffff;
    box-shadow: 0 5px 14px -4px rgb(0 0 0 / 0.46);
  }

  .collection-gallery-card__cta-icon {
    width: 0.46rem;
    height: 0.46rem;
    font-size: 0.46rem !important;
    flex-shrink: 0;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-gallery-card__cta-badge svg {
    width: 0.46rem !important;
    height: 0.46rem !important;
    font-size: 0.46rem !important;
  }

  .collection-gallery-card__cta:hover .collection-gallery-card__cta-icon {
    transform: translateX(1px);
  }

  /* ── Experience luxury card CTA ───────────────────────────────────────── */
  .experience-card__cta-wrap {
    position: relative;
    z-index: 2;
    display: inline-flex;
    width: fit-content;
    margin-top: 0.9rem;
    opacity: 1;
    transform: translateX(0);
    clip-path: inset(0 0 0 0 round 999px);
    filter: drop-shadow(0 9px 20px rgb(139 197 64 / 0.3));
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.12s,
      transform 0.72s cubic-bezier(0.22, 1, 0.36, 1) 0.1s,
      clip-path 0.78s cubic-bezier(0.22, 1, 0.36, 1) 0.08s,
      filter 0.55s ease 0.12s;
    pointer-events: auto;
  }

  .group:hover .experience-card__cta-wrap {
    opacity: 1;
    transform: translateX(0);
    clip-path: inset(0 0 0 0 round 999px);
    filter: drop-shadow(0 14px 28px rgb(139 197 64 / 0.5));
    pointer-events: auto;
  }

  .experience-card__cta-wrap--featured {
    opacity: 0.94;
    transform: translateX(0);
    clip-path: inset(0 0 0 0 round 999px);
    pointer-events: auto;
  }

  .experience-card__cta-wrap::after {
    content: "";
    position: absolute;
    inset: -2px;
    z-index: 3;
    border-radius: 999px;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent 36%,
      rgb(255 255 255 / 0.42) 50%,
      transparent 64%
    );
    transform: translateX(-130%) skewX(-8deg);
    transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.22s;
  }

  .group:hover .experience-card__cta-wrap::after {
    transform: translateX(130%) skewX(-8deg);
  }

  .experience-card__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    min-width: 10.5rem;
    padding: 0.46rem 0.5rem 0.46rem 1.12rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.16);
    background: linear-gradient(135deg, #a8d95a 0%, #8bc540 52%, #689a2e 100%);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
    white-space: nowrap;
    isolation: isolate;
    overflow: hidden;
    box-shadow:
      0 10px 26px -12px rgb(139 197 64 / 0.55),
      inset 0 1px 0 rgb(255 255 255 / 0.22);
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.18s,
      box-shadow 0.5s ease 0.18s,
      background 0.45s ease;
  }

  .group:hover .experience-card__cta {
    transform: translateY(-2px) scale(1.025);
    box-shadow:
      0 18px 38px -10px rgb(139 197 64 / 0.72),
      0 0 0 1px rgb(210 241 159 / 0.18),
      inset 0 1px 0 rgb(255 255 255 / 0.38);
  }

  .experience-card__cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, #ffffff 0%, #f4f2eb 100%);
    transform: translateY(105%);
    transition: transform 0.58s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .experience-card__cta:hover::before,
  .experience-card__cta:focus-visible::before {
    transform: translateY(0);
  }

  .experience-card__cta:hover,
  .experience-card__cta:focus-visible {
    color: #192012;
    border-color: rgb(255 255 255 / 0.72);
    box-shadow:
      0 18px 38px -10px rgb(0 0 0 / 0.48),
      0 0 0 1px rgb(255 255 255 / 0.22),
      inset 0 1px 0 rgb(255 255 255 / 0.86);
  }

  .experience-card__cta-label {
    position: relative;
    z-index: 1;
  }

  .experience-card__cta-badge {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.58rem;
    height: 1.58rem;
    border-radius: 999px;
    background: #2f5218;
    border: 1px solid rgb(255 255 255 / 0.14);
    color: #f8f6f2;
    overflow: hidden;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.28s,
      box-shadow 0.45s ease 0.28s;
  }

  .group:hover .experience-card__cta-badge {
    transform: scale(1.05);
    box-shadow: 0 5px 14px -4px rgb(0 0 0 / 0.48);
  }

  .experience-card__cta:hover .experience-card__cta-badge,
  .experience-card__cta:focus-visible .experience-card__cta-badge {
    transform: rotate(-8deg) scale(1.08);
    background: #192f0d;
    color: #ffffff;
  }

  .experience-card__cta-icon {
    width: 0.46rem;
    height: 0.46rem;
    font-size: 0.46rem !important;
    flex-shrink: 0;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.32s;
  }

  .experience-card__cta-badge svg {
    width: 0.46rem !important;
    height: 0.46rem !important;
    font-size: 0.46rem !important;
  }

  .group:hover .experience-card__cta-icon {
    transform: translateX(2px);
  }

  .experience-card__cta-wrap--compact .experience-card__cta {
    min-width: 9.5rem;
    padding: 0.4rem 0.44rem 0.4rem 1rem;
    font-size: 0.64rem;
  }

  .experience-card__cta-wrap--compact .experience-card__cta-badge {
    width: 1.45rem;
    height: 1.45rem;
  }

  .experience-card__cta-wrap--compact .experience-card__cta-icon,
  .experience-card__cta-wrap--compact .experience-card__cta-badge svg {
    width: 0.4rem !important;
    height: 0.4rem !important;
    font-size: 0.4rem !important;
  }

  .experience-card__cta-wrap--featured .experience-card__cta {
    min-width: 11.5rem;
    padding: 0.52rem 0.56rem 0.52rem 1.22rem;
    font-size: 0.74rem;
  }

  .experience-card__cta-wrap--featured .experience-card__cta-badge {
    width: 1.72rem;
    height: 1.72rem;
  }

  .experience-card__cta-wrap--featured .experience-card__cta-icon,
  .experience-card__cta-wrap--featured .experience-card__cta-badge svg {
    width: 0.5rem !important;
    height: 0.5rem !important;
    font-size: 0.5rem !important;
  }

  .btn-secondary {
    background: #2f5218;
    color: #f5f2ec;
    box-shadow: 0 18px 44px -32px rgba(47, 82, 24, 0.48);
  }

  .btn-secondary:hover {
    transform: translate3d(0, -2px, 0);
    background: linear-gradient(135deg, #3d6824, #2f5218);
  }

  .btn-outline {
    border: 1px solid transparent;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(248, 246, 242, 0.84)) padding-box,
      linear-gradient(
          135deg,
          rgba(23, 25, 28, 0.62),
          rgba(23, 25, 28, 0.34),
          rgba(200, 169, 107, 0.58)
        )
        border-box;
    color: #17191c;
    box-shadow:
      0 18px 44px -34px rgba(23, 25, 28, 0.22),
      inset 0 1px 0 rgb(255 255 255 / 0.78);
  }

  .btn-outline:hover {
    transform: translate3d(0, -2px, 0);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(248, 246, 242, 0.92)) padding-box,
      linear-gradient(
          135deg,
          rgba(23, 25, 28, 0.78),
          rgba(23, 25, 28, 0.4),
          rgba(200, 169, 107, 0.74)
        )
        border-box;
    box-shadow:
      0 26px 58px -38px rgba(23, 25, 28, 0.28),
      inset 0 1px 0 rgb(255 255 255 / 0.82);
  }

  .btn-outline {
    position: relative;
  }

  .btn-outline::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(circle at 20% 20%, rgba(200, 169, 107, 0.24), transparent 42%),
      radial-gradient(circle at 80% 30%, rgba(47, 82, 24, 0.2), transparent 48%),
      radial-gradient(circle at 40% 88%, rgba(139, 197, 64, 0.18), transparent 50%);
    opacity: 0;
    transition: opacity var(--motion-premium) var(--ease-premium);
    mix-blend-mode: multiply;
  }

  .btn-outline:hover::after {
    opacity: 1;
  }

  @keyframes lux-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .lux-border {
    position: relative;
    overflow: hidden;
  }

  .lux-border::before {
    content: "";
    position: absolute;
    inset: -80%;
    background: conic-gradient(
      from 140deg,
      rgba(200, 169, 107, 0.9),
      rgba(47, 82, 24, 0.55),
      rgba(139, 197, 64, 0.6),
      rgba(200, 169, 107, 0.9)
    );
    animation: lux-spin 10s linear infinite;
    opacity: 0.92;
  }

  .lux-border::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 0%, rgba(200, 169, 107, 0.18), transparent 46%),
      radial-gradient(circle at 20% 70%, rgba(139, 197, 64, 0.12), transparent 52%);
    opacity: 0.75;
    pointer-events: none;
  }

  .lux-x {
    position: relative;
    overflow: hidden;
    border-radius: 999px;
    transform: translateZ(0);
    transition:
      transform var(--motion-premium) var(--ease-premium),
      box-shadow var(--motion-premium) var(--ease-premium);
  }

  .lux-x::before {
    content: "";
    position: absolute;
    inset: -70%;
    background: conic-gradient(
      from 120deg,
      rgba(200, 169, 107, 0.92),
      rgba(23, 25, 28, 0.5),
      rgba(255, 255, 255, 0.12),
      rgba(200, 169, 107, 0.92)
    );
    animation: lux-spin 7.5s linear infinite;
    opacity: 0.85;
  }

  .lux-x::after {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: 999px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0)),
      rgba(23, 25, 28, 0.92);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 -1px 0 rgba(0, 0, 0, 0.35);
  }

  .lux-x > * {
    position: relative;
    z-index: 1;
  }

  .lux-x:hover {
    transform: translateY(-1px) scale(1.03);
    box-shadow: 0 20px 44px -30px rgba(0, 0, 0, 0.6);
  }

  .lux-x:active {
    transform: translateY(0) scale(0.98);
  }

  @keyframes testimonials-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .testimonials-row {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(139, 197, 64, 0.1);
    background: linear-gradient(145deg, rgba(15, 39, 48, 0.92), rgba(47, 82, 24, 0.86));
    box-shadow: 0 30px 80px -52px rgba(0, 0, 0, 0.7);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .testimonials-row:hover .testimonials-track {
    animation-play-state: paused;
  }

  .testimonials-fade {
    pointer-events: none;
    position: absolute;
    top: 0;
    bottom: 0;
    width: 140px;
    z-index: 2;
  }

  .testimonials-fade-left {
    left: 0;
    background: linear-gradient(90deg, rgba(23, 25, 28, 0.98), rgba(23, 25, 28, 0));
  }

  .testimonials-fade-right {
    right: 0;
    background: linear-gradient(270deg, rgba(23, 25, 28, 0.98), rgba(23, 25, 28, 0));
  }

  .testimonials-track {
    display: flex;
    gap: 14px;
    width: max-content;
    padding: 14px;
    will-change: transform;
    animation: testimonials-marquee var(--marquee-duration, 56s) linear infinite;
  }

  .testimonials-track-reverse {
    animation-direction: reverse;
  }

  .testimonials-track-static {
    animation: none;
  }

  .testimonials-card {
    width: min(420px, calc(100vw - 6rem));
    flex: 0 0 auto;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(248, 246, 242, 0.94), rgba(245, 241, 235, 0.92));
    padding: 16px 16px 14px;
    box-shadow: 0 18px 44px -34px rgba(0, 0, 0, 0.26);
  }

  .testimonials-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }

  .testimonials-source {
    font-size: 0.67rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #17191c;
  }

  .testimonials-text {
    font-size: 0.98rem;
    line-height: 1.75;
    font-weight: 300;
    color: rgba(23, 25, 28, 0.86);
  }

  @media (max-width: 640px) {
    .testimonials-fade {
      width: 90px;
    }

    .testimonials-track {
      padding: 12px;
    }

    .testimonials-card {
      width: min(340px, calc(100vw - 5.2rem));
      padding: 14px 14px 12px;
    }
  }

  .btn-primary:hover svg,
  .btn-secondary:hover svg,
  .btn-outline:hover svg {
    transform: translate3d(4px, 0, 0);
  }

  .link-underline {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
  }

  .link-underline::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--motion-premium) var(--ease-precise);
  }

  .link-underline:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .surface-card {
    border: 1px solid rgba(200, 169, 107, 0.15);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.8);
    box-shadow: var(--shadow-card);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    transition:
      transform var(--motion-premium) var(--ease-premium),
      box-shadow var(--motion-premium) var(--ease-premium),
      border-color var(--motion-normal) var(--ease-premium),
      background-color var(--motion-normal) var(--ease-premium);
  }

  .surface-card-soft {
    border: 1px solid rgba(200, 169, 107, 0.15);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.62);
    box-shadow: var(--shadow-soft);
  }

  .surface-card-dark {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(30, 32, 35, 0.96), rgba(23, 25, 28, 0.98));
    box-shadow: var(--shadow-dark);
  }

  .metric-item {
    padding: 1rem 1.1rem;
    border-radius: 0;
    border: 1px solid rgba(200, 169, 107, 0.15);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: var(--shadow-soft);
  }

  .brand-logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 5.25rem;
    padding-inline: 1.1rem;
    border-right: 1px solid rgb(255 255 255 / 0.08);
    color: rgb(255 255 255 / 0.92);
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.72;
    filter: brightness(0.9);
    transition:
      color var(--motion-normal) var(--ease-premium),
      opacity var(--motion-normal) var(--ease-premium),
      filter var(--motion-premium) var(--ease-premium);
  }

  .brand-logo-item:hover {
    color: #ffffff;
    opacity: 1;
    filter: brightness(1.08);
  }

  .check-list-item {
    display: flex;
    align-items: start;
    gap: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-soft);
  }

  .footer-link {
    color: rgb(255 255 255 / 0.78);
  }

  .footer-link:hover {
    color: #ffffff;
  }

  .luxury-navy-surface {
    background-color: #1a3310;
    background-image:
      radial-gradient(circle at top left, rgba(139, 197, 64, 0.08), transparent 40%),
      linear-gradient(135deg, #1a3310 0%, #2f5218 45%, #3d6824 100%);
  }
}

@layer components {
  .nav-shell {
    border: 1px solid transparent;
    border-radius: 9999px;
    padding: 0.5rem 0;
    transition:
      background-color var(--motion-luxury) var(--ease-premium),
      border-color var(--motion-premium) var(--ease-premium),
      box-shadow var(--motion-luxury) var(--ease-premium),
      padding var(--motion-luxury) var(--ease-premium),
      backdrop-filter var(--motion-luxury) var(--ease-premium);
  }

  .nav-band {
    position: relative;
    z-index: 1;
    transition:
      background-color var(--motion-luxury) var(--ease-premium),
      box-shadow var(--motion-luxury) var(--ease-premium),
      backdrop-filter var(--motion-luxury) var(--ease-premium);
  }

  .nav-topbar-band {
    background-color: #17191c;
    background-image: linear-gradient(180deg, #1e2023 0%, #17191c 100%);
    box-shadow: inset 0 -1px 0 rgba(200, 169, 107, 0.12);
    -webkit-backdrop-filter: blur(14px) saturate(125%);
    backdrop-filter: blur(14px) saturate(125%);
    transition:
      background-color 400ms ease,
      background-image 400ms ease,
      box-shadow 400ms ease,
      backdrop-filter 400ms ease;
  }

  .nav-topbar-band.nav-band-elevated,
  .nav-topbar-band.nav-band-forced {
    background-color: transparent;
    background-image: none;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Hero state: topbar becomes fully transparent, blending with the hero */
  .nav-topbar-band.nav-topbar-hero {
    background-color: transparent;
    background-image: none;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Scrolled (nav revealed on scroll-up): light frosted glass background
     with a hairline green accent underneath */
  .nav-band-elevated {
    background: linear-gradient(180deg, rgba(252, 251, 248, 0.92), rgba(246, 244, 238, 0.84));
    box-shadow:
      0 22px 54px -38px rgba(23, 25, 28, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.82),
      inset 0 -1px 0 rgba(139, 197, 64, 0.18);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    backdrop-filter: blur(20px) saturate(140%);
  }

  .nav-band-forced {
    background: #faf8f4;
    box-shadow:
      0 16px 34px -30px rgba(23, 25, 28, 0.4),
      inset 0 -1px 0 rgba(139, 197, 64, 0.2);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .nav-root-elevated {
    background: transparent;
  }

  .nav-topbar-wrap {
    pointer-events: none;
    position: relative;
    z-index: 1;
    color: rgba(245, 242, 236, 0.65);
    transition:
      opacity var(--motion-premium) var(--ease-premium),
      margin-top var(--motion-luxury) var(--ease-premium);
  }

  .nav-topbar {
    pointer-events: auto;
  }

  /* Scrolled: topbar folds away so only the floating capsule remains */
  .nav-topbar-wrap-elevated {
    opacity: 0;
    margin-top: -2.75rem;
    pointer-events: none;
  }

  .nav-topbar-wrap-elevated .nav-topbar {
    pointer-events: none;
  }

  .nav-topbar-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
    color: currentColor;
  }

  .nav-topbar-icon {
    width: 0.9rem;
    height: 0.9rem;
    color: currentColor;
    stroke-width: 1.8;
  }

  .nav-topbar-sep {
    width: 1px;
    height: 14px;
    margin-inline: 1rem;
    background: rgba(245, 242, 236, 0.14);
  }

  .nav-topbar-google-pill {
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid rgba(200, 169, 107, 0.28);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.04);
    transition:
      border-color var(--motion-premium) var(--ease-premium),
      background-color var(--motion-premium) var(--ease-premium);
  }

  .nav-topbar-google-pill:hover {
    border-color: rgba(200, 169, 107, 0.42);
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-topbar-stars {
    display: inline-flex;
    align-items: center;
    gap: 1px;
  }

  .nav-topbar-accent-icon {
    color: #8bc540;
  }

  .nav-frame {
    box-shadow: none;
    position: relative;
    z-index: 1;
  }

  .nav-shell-top {
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .nav-shell-scrolled {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Scrolled: shell itself stays clean — the band carries the glass background */
  .nav-shell-elevated {
    border: 0;
    border-radius: 0;
    padding: 0.35rem 0;
    background: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .nav-shell-elevated .nav-logo {
    filter: drop-shadow(0 6px 18px rgba(139, 197, 64, 0.22));
  }

  .nav-shell-elevated .nav-link::after {
    background: linear-gradient(90deg, transparent, rgba(139, 197, 64, 0.85), transparent);
  }

  /* No dark wash bar behind the navbar — hero shows through completely */
  .nav-header-wash {
    position: absolute;
    inset: 0 0 auto;
    height: 13rem;
    pointer-events: none;
    background: transparent !important;
    filter: none;
    opacity: 0 !important;
  }

  /* Logo stays green everywhere; slight lift over dark heroes */
  .nav-logo {
    transition:
      filter var(--motion-premium) var(--ease-premium),
      transform var(--motion-premium) var(--ease-premium);
  }

  .nav-hero .nav-logo {
    filter: brightness(1.12) saturate(1.18) drop-shadow(0 2px 12px rgba(5, 10, 6, 0.35));
  }

  .nav-hide {
    transform: translateY(-120%);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.015em;
    text-transform: none;
    color: #111111;
    transition:
      color var(--motion-normal) var(--ease-premium),
      opacity var(--motion-normal) var(--ease-premium);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.12rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(23, 25, 28, 0.44), transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-premium) var(--ease-precise);
  }

  .nav-link:hover {
    color: rgb(27 27 27 / 0.96);
  }

  .nav-link[data-active="true"] {
    color: rgb(27 27 27 / 0.96);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-link[data-active="true"]::after {
    transform: scaleX(1);
    background: linear-gradient(90deg, transparent, rgb(201 164 106 / 0.92), transparent);
  }

  .nav-hero .nav-link {
    color: rgb(247 245 242 / 0.78);
  }

  .nav-hero .nav-link:hover {
    color: rgb(247 245 242 / 0.96);
  }

  .nav-hero .nav-link[data-active="true"] {
    color: rgb(247 245 242 / 0.96);
  }

  .nav-hero .nav-link::after {
    background: linear-gradient(90deg, transparent, rgb(247 245 242 / 0.4), transparent);
  }

  .nav-hero .nav-link[data-active="true"]::after {
    background: linear-gradient(90deg, transparent, rgb(201 164 106 / 0.92), transparent);
  }

  .nav-hero .nav-link {
    text-shadow: 0 1px 12px rgba(5, 10, 6, 0.45);
  }

  .nav-mobile-toggle {
    box-shadow:
      0 18px 34px -28px rgb(7 17 27 / 0.18),
      inset 0 1px 0 rgb(255 255 255 / 0.42);
  }

  .nav-mobile-toggle-lines {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.27rem;
  }

  .nav-mobile-toggle-lines span {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--motion-normal) var(--ease-premium);
  }

  .nav-mobile-panel {
    background: #faf8f4;
  }

  .nav-mobile-meta {
    font-size: 0.67rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgb(176 141 87 / 0.92);
  }

  .nav-mobile-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 9vw, 2.9rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--foreground);
    text-align: center;
    transition:
      color var(--motion-normal) var(--ease-premium),
      transform var(--motion-normal) var(--ease-premium);
  }

  .nav-mobile-link:hover {
    transform: translateY(-1px);
  }

  .nav-mobile-link[data-active="true"] {
    color: var(--gold);
  }

  .nav-mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4rem;
    width: min(100%, 18.5rem);
    padding-inline: 1.8rem;
    border-radius: 2px;
    border: 1px solid rgba(23, 25, 28, 0.08);
    color: #f5f2ec;
    background: #111315;
    box-shadow: 0 22px 46px -34px rgba(23, 25, 28, 0.4);
    font-size: 0.92rem;
    letter-spacing: 0.14em;
    text-transform: none;
  }

  .nav-mobile-close {
    position: relative;
  }

  .nav-mobile-close-lines {
    position: relative;
    display: block;
    width: 1.2rem;
    height: 1.2rem;
  }

  .nav-mobile-close-lines span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.2rem;
    height: 1.5px;
    background: currentColor;
  }

  .nav-mobile-close-lines span:first-child {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .nav-mobile-close-lines span:last-child {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* Hairline that quietly separates the menu from the CTA */
  .nav-divider {
    width: 1px;
    height: 1.35rem;
    background: linear-gradient(180deg, transparent, rgba(23, 25, 28, 0.22), transparent);
  }

  .nav-hero .nav-divider {
    background: linear-gradient(180deg, transparent, rgba(247, 245, 242, 0.32), transparent);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.6rem 0.6rem 0.6rem 1.25rem;
    position: relative;
    overflow: hidden;
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffffff;
    background: linear-gradient(135deg, #a8d95a 0%, #8bc540 52%, #689a2e 100%);
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.26) inset,
      0 10px 26px -10px rgba(139, 197, 64, 0.45);
    transition:
      transform var(--motion-premium) var(--ease-premium),
      box-shadow var(--motion-premium) var(--ease-premium),
      border-color var(--motion-normal) var(--ease-premium),
      background var(--motion-premium) var(--ease-premium);
  }

  /* Arrow lives in its own deep-green square — the signature detail */
  .nav-cta__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 7px;
    color: #f5f2ec;
    background: rgba(35, 74, 20, 0.85);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14) inset;
    transition:
      transform var(--motion-premium) var(--ease-premium),
      background var(--motion-premium) var(--ease-premium);
  }

  .nav-cta::after {
    content: "";
    position: absolute;
    inset: -40% -30%;
    pointer-events: none;
    background: linear-gradient(90deg, transparent 0%, rgb(255 255 255 / 0.2) 48%, transparent 70%);
    transform: translateX(-45%) rotate(12deg);
    opacity: 0;
    transition:
      opacity var(--motion-normal) var(--ease-premium),
      transform var(--motion-luxury) var(--ease-premium);
  }

  .nav-cta:hover,
  .nav-cta:focus-visible {
    transform: translateY(-1px);
    background: linear-gradient(135deg, #b8e06a 0%, #8bc540 46%, #5e8c28 100%);
    border-color: rgba(255, 255, 255, 0.34);
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.3) inset,
      0 16px 36px -10px rgba(139, 197, 64, 0.55),
      0 0 24px -6px rgba(139, 197, 64, 0.28);
  }

  .nav-cta:hover::after {
    opacity: 1;
    transform: translateX(45%) rotate(12deg);
  }

  .nav-cta:hover .nav-cta__arrow {
    transform: translateX(2px);
    background: rgba(35, 74, 20, 1);
  }

  .nav-cta:focus-visible {
    outline: 2px solid rgba(139, 197, 64, 0.6);
    outline-offset: 3px;
  }

  .editorial-h {
    font-family: var(--font-display);
    line-height: 0.98;
    letter-spacing: -0.04em;
    font-weight: 400;
    text-wrap: balance;
  }

  .text-muted-light {
    color: rgb(247 245 242 / 0.68);
  }

  .image-zoom img {
    transition:
      transform var(--motion-luxury) var(--ease-premium),
      filter var(--motion-premium) var(--ease-premium);
  }

  .image-zoom:hover img {
    transform: scale(1.04);
    filter: brightness(0.94);
  }

  .btn-gold {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.35rem;
    padding: 0.9rem 1.9rem;
    border: 1px solid var(--accent);
    border-radius: 0;
    background: var(--accent);
    color: var(--ivory);
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      transform var(--motion-premium) var(--ease-premium),
      background-color var(--motion-premium) var(--ease-premium),
      box-shadow var(--motion-premium) var(--ease-premium);
  }

  .btn-gold:hover {
    transform: translateY(-2px);
    background: #a6874e;
    box-shadow: 0 20px 44px -28px rgba(200, 169, 107, 0.38);
  }

  .reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity var(--motion-luxury) var(--ease-premium),
      transform var(--motion-luxury) var(--ease-premium);
  }

  .reveal.in {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 1023px) {
  .nav-header-wash {
    height: 8rem;
    background: transparent;
  }
}

@media (max-width: 767px) {
  .nav-topbar-wrap {
    display: none;
  }

  .nav-band {
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .nav-band-elevated {
    background: linear-gradient(180deg, rgba(252, 251, 248, 0.94), rgba(246, 244, 238, 0.9));
    box-shadow: inset 0 -1px 0 rgba(139, 197, 64, 0.18);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
    backdrop-filter: blur(18px) saturate(135%);
  }

  .nav-band-forced {
    background: #faf8f4;
    box-shadow: inset 0 -1px 0 rgba(139, 197, 64, 0.2);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .nav-shell-elevated {
    padding: 0.2rem 0;
  }

  .nav-link {
    font-size: 0.88rem;
  }

  .nav-cta {
    min-height: 3.25rem;
    padding: 0.72rem 0.72rem 0.72rem 1.4rem;
    font-size: 0.66rem;
  }
}

/* ─── Route-aware mobile app shell ─────────────────────────────── */
:root {
  --app-safe-top: env(safe-area-inset-top, 0px);
  --app-safe-right: env(safe-area-inset-right, 0px);
  --app-safe-bottom: env(safe-area-inset-bottom, 0px);
  --app-safe-left: env(safe-area-inset-left, 0px);
  --app-mobile-header: 72px;
  --app-mobile-nav: 72px;
}

.mobile-app-shell {
  min-height: 100%;
}

.mobile-app-bottom-nav {
  display: none;
}

@media (max-width: 767px) {
  html {
    scroll-padding-top: calc(var(--app-mobile-header) + var(--app-safe-top) + 0.75rem);
    -webkit-overflow-scrolling: touch;
  }

  body {
    overscroll-behavior-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-app-shell,
  .mobile-app-shell__content {
    overflow: visible;
    min-height: auto;
  }

  .mobile-app-shell[data-mobile-shell-mode="marketing"] .mobile-app-shell__content {
    padding-bottom: calc(var(--app-mobile-nav) + var(--app-safe-bottom));
  }

  .mobile-app-bottom-nav {
    position: fixed;
    z-index: 1100;
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    padding-right: max(0.5rem, var(--app-safe-right));
    padding-bottom: max(0.45rem, var(--app-safe-bottom));
    padding-left: max(0.5rem, var(--app-safe-left));
    pointer-events: none;
  }

  .mobile-app-bottom-nav::before {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: calc(100% + 1rem);
    background: linear-gradient(to top, rgba(244, 242, 236, 0.98) 70%, rgba(244, 242, 236, 0));
    content: "";
    pointer-events: none;
  }

  .mobile-app-bottom-nav__inner {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-height: var(--app-mobile-nav);
    overflow: hidden;
    border: 1px solid rgba(23, 28, 20, 0.1);
    border-radius: 24px;
    background: rgba(255, 255, 252, 0.94);
    box-shadow:
      0 18px 48px -20px rgba(15, 24, 12, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(22px) saturate(145%);
    pointer-events: auto;
  }

  .mobile-app-bottom-nav__item {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 68px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.22rem;
    color: #596052;
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    transition:
      color 180ms ease,
      transform 100ms ease;
  }

  .mobile-app-bottom-nav__item:active {
    transform: scale(0.94);
  }

  .mobile-app-bottom-nav__icon {
    display: grid;
    width: 34px;
    height: 30px;
    place-items: center;
    border-radius: 12px;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .mobile-app-bottom-nav__item--active {
    color: #436d1e;
  }

  .mobile-app-bottom-nav__item--active .mobile-app-bottom-nav__icon {
    background: rgba(139, 197, 64, 0.14);
    color: #679c2f;
  }

  .mobile-app-bottom-nav__item--primary {
    color: #36591b;
  }

  .mobile-app-bottom-nav__item--primary .mobile-app-bottom-nav__icon {
    background: linear-gradient(145deg, #95ce4b, #6aa52d);
    color: white;
    box-shadow: 0 9px 20px -10px rgba(77, 126, 31, 0.9);
  }

  [data-sonner-toaster] {
    bottom: calc(var(--app-mobile-nav) + var(--app-safe-bottom) + 0.8rem) !important;
  }

  button,
  a,
  input,
  select,
  textarea,
  summary,
  [role="button"] {
    -webkit-tap-highlight-color: transparent;
  }

  :is(button, a, input, select, textarea, summary, [role="button"]):focus-visible {
    outline: 2px solid #76ad39;
    outline-offset: 3px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto !important;
  }

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ─── Journey configure mobile shell (matches React lg breakpoint) ─ */
@media (max-width: 1023px) {
  .journey-premium-scene,
  .journey-config-scene.journey-config-scene--react {
    overflow: visible;
    background: #111111 !important;
    padding-top: 0;
    padding-inline: 0;
  }

  .journey-config-scene--react .journey-config-scene__photo,
  .journey-config-scene--react .journey-config-scene__veil,
  .journey-config-scene--react .journey-config-scene__ambient,
  .journey-premium-scene__grain--desktop {
    display: none;
  }

  .journey-config-scene__inner--desktop {
    display: none !important;
  }

  .journey-configure-mobile {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: #111111;
    overflow: hidden;
    box-shadow: none;
    padding-bottom: calc(var(--configurator-mobile-action, 70px) + 0.5rem);
  }

  .journey-configure-mobile:has(.configure-options-panel--open)::before {
    position: fixed;
    inset: 0;
    z-index: 1245;
    background: rgba(0, 0, 0, 0.42);
    content: "";
    pointer-events: none;
  }

  .journey-configure-mobile__progress {
    height: 2px;
    background: rgba(139, 197, 64, 0.15);
  }

  .journey-configure-mobile__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding-inline: 0.75rem;
    border-bottom: 1px solid rgba(139, 197, 64, 0.16);
    background: #111411;
  }

  .journey-configure-mobile .configure-image-stage,
  .journey-configure-mobile__stage {
    position: relative;
    top: auto;
    width: 100%;
    height: 36svh;
    min-height: 260px;
    max-height: 380px;
    flex: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 18px 40px -26px rgba(0, 0, 0, 0.85);
  }

  .journey-configure-mobile__stage-media {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .journey-configure-mobile__sidebar {
    flex: 0 0 auto;
    min-height: 0;
  }

  .journey-configure-mobile .configure-options-panel {
    display: none;
  }

  .journey-configure-mobile .configure-options-panel--open {
    position: fixed;
    z-index: 1250;
    right: 0.75rem;
    bottom: calc(
      var(--configurator-mobile-action, 70px) + var(--app-mobile-nav, 72px) +
        env(safe-area-inset-bottom, 0px) + 0.4rem
    );
    left: 0.75rem;
    display: block;
    max-width: 28rem;
    margin-inline: auto;
    max-height: min(52dvh, 420px);
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid rgba(200, 169, 107, 0.24);
    border-radius: 22px;
    background: linear-gradient(165deg, #171a15, #0d100d);
    box-shadow: 0 28px 80px -24px rgba(0, 0, 0, 0.92);
    animation: mobile-sheet-in 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .journey-configure-mobile .configure-options-panel--open::before {
    display: block;
    width: 2.5rem;
    height: 4px;
    margin: 0.15rem auto 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    content: "";
  }

  .journey-configure-mobile__action {
    position: fixed;
    right: 0;
    bottom: calc(var(--app-mobile-nav, 72px) + env(safe-area-inset-bottom, 0px));
    left: 0;
    z-index: 1240;
    border-top: 1px solid rgba(247, 245, 242, 0.08);
    background: rgba(10, 10, 10, 0.94);
    backdrop-filter: blur(12px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .journey-premium-scene.section-shell {
    padding-inline: 0;
    padding-top: 0;
    padding-bottom: calc(
      var(--configurator-mobile-action, 70px) + var(--app-mobile-nav, 72px) +
        env(safe-area-inset-bottom, 0px) + 1.25rem
    );
  }

  .journey-premium-scene__container {
    width: 100%;
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
    padding-inline: 0;
  }

  .journey-premium-scene .chapter-mark {
    display: none;
  }

  .journey-premium-grid {
    gap: 0;
  }

  .journey-premium-stage {
    padding-inline: 0;
  }

  .journey-premium-desktop {
    display: none !important;
  }
}

/* ─── Public experience: touch-first mobile composition ───────── */
@media (max-width: 767px) {
  .site-container {
    width: min(calc(100% - 2rem), var(--container-width));
  }

  .section-shell {
    padding-block: clamp(3.75rem, 16vw, 5rem);
  }

  .eyebrow,
  [class*="tracking-[0.2"],
  [class*="tracking-[0.3"] {
    letter-spacing: 0.12em;
  }

  .premium-pill-button {
    min-height: 48px;
    padding-left: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .premium-pill-button__badge,
  .premium-pill-button--sm .premium-pill-button__badge,
  .premium-pill-button--md .premium-pill-button__badge {
    width: 2.35rem;
    height: 2.35rem;
  }

  .home-hero {
    min-height: auto;
    padding-top: calc(var(--app-safe-top) + 5.25rem);
  }

  .home-hero__layout {
    min-height: auto !important;
    align-content: start;
    padding-bottom: calc(var(--app-mobile-nav) + 1.25rem);
  }

  .home-hero .hero-display {
    font-size: clamp(1.72rem, 7.4vw, 2.15rem);
    line-height: 1.05;
    letter-spacing: -0.028em;
  }

  .home-hero .hero-scroll-cue {
    display: none;
  }

  .home-hero .section-label-row {
    align-items: flex-start;
    margin-bottom: 0.7rem;
    gap: 0.55rem;
  }

  .home-hero h1 + p {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 0.75rem;
    max-width: 22rem;
    font-size: 0.84rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .home-hero h1 + p + div {
    margin-top: 1rem;
  }

  .home-hero .eyebrow {
    max-width: 15rem;
    font-size: 0.56rem;
    line-height: 1.45;
    letter-spacing: 0.1em;
  }

  .home-hero__actions {
    width: 100%;
    flex-wrap: nowrap;
    gap: 0.55rem;
  }

  .home-hero__cta {
    flex: 1 1 0;
    min-width: 0;
    width: auto !important;
    max-width: none;
    justify-content: space-between;
    min-height: 44px;
    padding: 0.22rem 0.22rem 0.22rem 0.72rem;
    font-size: 0.52rem;
    letter-spacing: 0.06em;
  }

  .home-hero__cta .premium-pill-button__badge {
    width: 1.85rem;
    height: 1.85rem;
  }

  .home-hero__cta .premium-pill-button__icon {
    width: 0.7rem;
    height: 0.7rem;
  }

  .home-hero__cta .premium-pill-button__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Partner slide chip: keep desktop horizontal dots on mobile (no UA button min-height) */
  .home-hero__partner {
    margin-top: 0.85rem;
  }

  .home-hero__partner-chip {
    gap: 0.45rem;
    min-height: 0;
    padding: 0.28rem 0.55rem;
  }

  .home-hero__partner-brand {
    font-size: 0.56rem;
    letter-spacing: 0.16em;
    line-height: 1;
  }

  .home-hero__partner-rule {
    width: 1rem;
  }

  .home-hero__partner-dots {
    gap: 0.3rem;
    height: 6px;
    align-items: center;
  }

  .home-hero__partner-dot {
    box-sizing: border-box;
    height: 6px !important;
    min-height: 0 !important;
    max-height: 6px !important;
    padding: 0 !important;
    margin: 0;
    border: 0 !important;
    border-radius: 999px;
    line-height: 0 !important;
    font-size: 0 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    -webkit-appearance: none;
    appearance: none;
    touch-action: manipulation;
  }

  .brand-page-hero,
  .brand-page-hero__content {
    min-height: max(43rem, 100svh) !important;
  }

  .brand-page-hero__content {
    justify-content: flex-end;
    padding-top: calc(var(--app-safe-top) + 7rem) !important;
    padding-bottom: 4.5rem !important;
  }

  .brand-page-hero__badge-strip {
    max-width: calc(100vw - 2rem);
    justify-content: flex-start;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .brand-page-hero__badge {
    min-width: max-content;
    scroll-snap-align: start;
  }

  .collection-gallery {
    margin-top: 2rem;
    padding-bottom: 0;
  }

  .collection-gallery > .pointer-events-none {
    display: none;
  }

  .collection-gallery__viewport {
    padding-block: 0.75rem 1.5rem;
    scroll-padding-inline: 1rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .collection-gallery__viewport::-webkit-scrollbar,
  .process-mobile-steps::-webkit-scrollbar,
  .brand-page-hero__badge-strip::-webkit-scrollbar {
    display: none;
  }

  .collection-gallery__track {
    gap: 0.85rem !important;
    padding-inline: 1rem !important;
  }

  .collection-gallery__slide {
    width: min(82vw, 310px) !important;
    height: 430px !important;
    scroll-snap-align: center;
  }

  .collection-gallery-card {
    border-radius: 24px;
  }

  .collection-gallery-card__description {
    opacity: 1;
    transform: none;
  }

  .collection-gallery-card__cta-wrap {
    opacity: 1;
    transform: none;
  }

  .process-mobile-steps {
    margin-inline: -1rem;
    padding-inline: 1rem;
    scroll-padding-inline: 1rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .process-mobile-step {
    scroll-snap-align: center;
  }

  .brands-carousel-grid {
    margin-top: 1rem;
    gap: 1.75rem;
  }

  .brands-carousel-grid > :first-child {
    height: 390px;
    max-width: min(92vw, 380px);
  }

  .brands-carousel-grid > :first-child article {
    inset: 2% 7%;
    border-radius: 26px;
  }

  .brands-carousel-grid .premium-pill-button {
    width: 100%;
    justify-content: space-between;
  }

  .brands-marquee {
    margin-top: 2.25rem;
    overflow-x: clip;
    padding-block: 0.65rem;
  }

  .brands-marquee__item {
    gap: 1.5rem;
    padding-inline: 0.85rem;
  }

  .brands-marquee__item .group\/logo {
    min-width: 96px;
    padding-block: 0.2rem;
  }

  .brands-marquee__tooltip {
    display: none;
  }

  .brands-pager-dot,
  .brands-pager-dot[aria-pressed] {
    box-sizing: border-box;
    height: 6px !important;
    min-height: 0 !important;
    max-height: 6px !important;
    padding: 0 !important;
    border: 0 !important;
    line-height: 0 !important;
    font-size: 0 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    -webkit-appearance: none;
    appearance: none;
  }

  .brands-pager-dot[aria-pressed="false"] {
    width: 8px !important;
  }

  .brands-pager-dot[aria-pressed="true"] {
    width: 3rem !important;
  }

  footer .site-container > div:first-of-type .premium-pill-button,
  footer .site-container > div:nth-of-type(2) .premium-pill-button {
    width: 100%;
    justify-content: space-between;
  }

  footer summary::-webkit-details-marker {
    display: none;
  }

  footer [class*="pb-20"][class*="pt-24"] {
    padding-block: 4.5rem;
  }
}

@media (max-width: 767px) and (max-height: 720px) {
  .home-hero {
    padding-top: calc(var(--app-safe-top) + 4.75rem);
  }

  .home-hero__layout {
    padding-bottom: calc(var(--app-mobile-nav) + 0.75rem);
  }

  .home-hero .hero-display {
    font-size: clamp(1.55rem, 6.8vw, 1.95rem);
  }

  .home-hero h1 + p {
    -webkit-line-clamp: 2;
    font-size: 0.78rem;
  }

  .home-hero .mt-6 {
    margin-top: 0.7rem;
  }

  .home-hero .mt-8 {
    margin-top: 0.85rem;
  }
}

@media (hover: none) and (pointer: coarse) {
  .collection-gallery-card:hover,
  .collection-gallery-card:active {
    transform: none;
  }

  .brands-marquee__item .brand-logo-white {
    opacity: 0;
  }

  .brands-marquee__item .brand-logo-color,
  .brands-marquee__item .brand-logo-badge {
    opacity: 1;
    transform: scale(1);
  }

  /* Keep CTA/nav targets tappable, but never inflate compact indicator dots */
  :is(a, button, summary, [role="button"]):not(.ui-dot):not(.home-hero__partner-dot) {
    min-height: 44px;
  }

  .ui-dot,
  .home-hero__partner-dot {
    position: relative;
    min-height: 0 !important;
  }

  .ui-dot::before,
  .home-hero__partner-dot::before {
    content: "";
    position: absolute;
    inset: -18px -10px;
  }
}

/* ─── Configurator mobile application flow ────────────────────── */
:root {
  --configurator-mobile-header: 98px;
  --configurator-mobile-action: 70px;
}

.configurator-mobile-header {
  display: none;
}

@media (max-width: 767px) {
  .configurator-mobile-header {
    position: fixed;
    z-index: 1200;
    top: 0;
    right: 0;
    left: 0;
    display: block;
    padding-top: var(--app-safe-top);
    border-bottom: 1px solid rgba(17, 20, 16, 0.08);
    background: #faf9f5;
    box-shadow: 0 14px 32px -26px rgba(17, 20, 16, 0.48);
  }

  .configurator-mobile-header__row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    height: 58px;
    align-items: center;
    justify-items: center;
    padding-inline: 0.75rem;
  }

  .configurator-mobile-header__action {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 14px;
    color: #3a4034;
  }

  .configurator-mobile-header__action:active {
    background: rgba(139, 197, 64, 0.1);
    color: #517c27;
  }

  .configurator-mobile-header__progress {
    position: relative;
    display: flex;
    height: 40px;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
    padding: 0 1rem 4px;
    color: #747a6d;
    font-size: 0.66rem;
  }

  .configurator-mobile-header__progress strong {
    color: #282c25;
    font-size: 0.7rem;
    font-weight: 650;
  }

  .configurator-mobile-header__progress-bar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 3px;
    background: rgba(139, 197, 64, 0.13);
  }

  .configurator-mobile-header__progress-bar::after {
    display: block;
    width: var(--flow-progress);
    height: 100%;
    border-radius: 0 99px 99px 0;
    background: linear-gradient(90deg, #6da62f, #a4d960);
    content: "";
    transition: width 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .configurator-mobile-header + section {
    padding-top: calc(var(--configurator-mobile-header) + var(--app-safe-top)) !important;
  }

  .flow-action-bar {
    z-index: 1150;
    border-color: rgba(24, 29, 21, 0.1);
    background: #fbfaf6 !important;
    box-shadow: 0 -18px 44px -30px rgba(18, 27, 14, 0.55);
    backdrop-filter: none;
  }

  [data-mobile-shell-mode="flow"] .mobile-app-shell__content {
    padding-bottom: calc(var(--configurator-mobile-action) + var(--app-safe-bottom));
  }

  .configure-layout {
    padding-top: calc(62px + var(--app-safe-top)) !important;
    padding-bottom: calc(var(--configurator-mobile-action) + var(--app-safe-bottom));
  }

  .configure-app-header {
    height: calc(60px + var(--app-safe-top));
    padding-top: var(--app-safe-top);
  }

  .configure-image-stage {
    top: calc(60px + var(--app-safe-top));
    width: 100%;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 18px 40px -26px rgba(0, 0, 0, 0.85);
  }

  .configure-hotspot {
    touch-action: manipulation;
  }

  .configure-category-rail {
    scroll-padding-inline: 0.75rem;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .configure-category-rail::-webkit-scrollbar,
  .moodboard-actions::-webkit-scrollbar {
    display: none;
  }

  .configure-category-rail > button {
    scroll-snap-align: start;
  }

  .configure-options-panel {
    display: none;
  }

  .configure-options-panel--open {
    position: fixed;
    z-index: 1250;
    right: 0.5rem;
    bottom: calc(var(--configurator-mobile-action) + var(--app-safe-bottom) + 0.4rem);
    left: 0.5rem;
    display: block;
    max-height: min(58dvh, 540px);
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid rgba(200, 169, 107, 0.24);
    border-radius: 26px;
    background: linear-gradient(165deg, #171a15, #0d100d);
    box-shadow: 0 28px 80px -24px rgba(0, 0, 0, 0.92);
    animation: mobile-sheet-in 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .configure-options-panel--open::before {
    display: block;
    width: 2.5rem;
    height: 4px;
    margin: 0.15rem auto 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    content: "";
  }

  .configure-summary {
    display: none;
  }

  .moodboard-actions {
    margin-right: -1rem;
    margin-left: -1rem;
    padding-right: 1rem;
    padding-left: 1rem;
    scroll-padding-inline: 1rem;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .moodboard-actions > button {
    scroll-snap-align: start;
  }

  .consultation-hero h1 {
    font-size: clamp(1.75rem, 8vw, 2.2rem);
    line-height: 1.03;
  }

  input,
  select,
  textarea {
    min-height: 48px;
    font-size: 16px !important;
  }
}

@keyframes mobile-sheet-in {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes hotspotBreathe {
  0%,
  100% {
    transform: scale(0.97);
    box-shadow:
      0 0 12px rgba(255, 255, 255, 0.14),
      0 0 20px rgba(200, 169, 107, 0.14);
  }
  50% {
    transform: scale(1.04);
    box-shadow:
      0 0 18px rgba(255, 255, 255, 0.22),
      0 0 28px rgba(200, 169, 107, 0.24);
  }
}

@keyframes app-marquee {
  to {
    transform: translateX(calc(-50% - var(--marquee-gap) / 2));
  }
}

@keyframes kc-scroll-up {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(-50%);
  }
}
@keyframes kc-scroll-down {
  0% {
    transform: translateY(-50%);
  }
  100% {
    transform: translateY(0);
  }
}
@keyframes kc-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6px);
  }
}
@keyframes kc-dash {
  0% {
    stroke-dashoffset: 553;
  }
  100% {
    stroke-dashoffset: 11;
  }
}

@utility animate-kc-scroll-up {
  animation: kc-scroll-up 80s linear infinite;
}
@utility animate-kc-scroll-down {
  animation: kc-scroll-down 80s linear infinite;
}
@utility animate-kc-float {
  animation: kc-float 8s ease-in-out infinite;
}
@utility animate-kc-dash {
  animation: kc-dash 2.2s ease-out forwards;
}
@keyframes brand-roundel-spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}
@keyframes kc-scroll-x {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}
@keyframes kc-shimmer {
  0% {
    transform: translateX(-120%) rotate(8deg);
  }
  100% {
    transform: translateX(220%) rotate(8deg);
  }
}
@utility animate-kc-scroll-x {
  animation: kc-scroll-x 60s linear infinite;
}
@utility animate-kc-shimmer {
  animation: kc-shimmer 6s ease-in-out infinite;
}

@layer components {
  .brand-glow-hover {
    transition: box-shadow var(--motion-premium) var(--ease-premium);
  }

  .brand-glow-hover:hover {
    box-shadow:
      0 0 32px rgba(139, 197, 64, 0.15),
      0 20px 48px -24px rgba(47, 82, 24, 0.25);
  }

  .brand-glow-cta {
    box-shadow: 0 12px 32px -12px rgba(139, 197, 64, 0.3);
    transition: box-shadow var(--motion-premium) var(--ease-premium);
  }

  .brand-glow-cta:hover {
    box-shadow:
      0 0 48px rgba(139, 197, 64, 0.22),
      0 24px 56px -16px rgba(139, 197, 64, 0.35);
  }

  .surface-card:hover {
    box-shadow:
      var(--shadow-card),
      0 0 0 1px rgba(139, 197, 64, 0.08),
      0 8px 24px -12px rgba(139, 197, 64, 0.12);
  }

  /* ── Brand kitchen pages ───────────────────────────────────── */
  .brand-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--green);
  }

  .brand-eyebrow--light {
    color: var(--green-highlight);
  }

  .brand-eyebrow--light .kitchen-eyebrow-mark {
    border-color: rgba(200, 169, 107, 0.42);
    background:
      radial-gradient(circle at 28% 18%, rgba(255, 255, 255, 0.22), transparent 42%),
      linear-gradient(145deg, rgba(200, 169, 107, 0.15), rgba(139, 197, 64, 0.1));
  }

  .brand-page-hero__logo-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.05rem;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.95);
    box-shadow:
      0 16px 44px -20px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .brand-page-hero__badge-strip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(10, 20, 12, 0.42);
    backdrop-filter: blur(18px);
    box-shadow:
      0 18px 48px -24px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .brand-page-hero__badge {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.6rem;
  }

  .brand-page-hero__badge-divider {
    position: absolute;
    left: 0;
    top: 22%;
    bottom: 22%;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(255, 255, 255, 0.18) 50%,
      transparent 100%
    );
  }

  .brand-page-hero__badge-value {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .brand-page-hero__badge-label {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.52);
  }

  .brand-page-intro__frame {
    position: relative;
  }

  /* Offset hairline frame behind the image — gallery-plinth effect */
  .brand-page-intro__frame::before {
    content: "";
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 1px solid rgba(139, 197, 64, 0.28);
    border-radius: 30px;
    pointer-events: none;
  }

  .brand-page-intro__image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 26px;
    box-shadow: 0 40px 100px -44px rgba(47, 82, 24, 0.4);
  }

  .brand-page-intro__image {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    transition: transform 1s var(--ease-premium);
  }

  .brand-page-intro__frame:hover .brand-page-intro__image {
    transform: scale(1.035);
  }

  .brand-page-intro__glow {
    pointer-events: none;
    position: absolute;
    inset: auto -10% -20% -10%;
    height: 45%;
    background: radial-gradient(ellipse at center, rgba(139, 197, 64, 0.2) 0%, transparent 70%);
  }

  /* Rotating heritage roundel — overlaps the image corner */
  .brand-page-intro__roundel {
    position: absolute;
    top: -2.4rem;
    right: -1.6rem;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 8.4rem;
    height: 8.4rem;
    border-radius: 999px;
    border: 1px solid rgba(168, 217, 90, 0.3);
    background:
      radial-gradient(ellipse at 30% 25%, rgba(168, 217, 90, 0.16) 0%, transparent 55%),
      linear-gradient(150deg, #16240f 0%, #2b4a17 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 22px 54px -24px rgba(10, 20, 12, 0.6);
  }

  @media (max-width: 1023px) {
    .brand-page-intro__roundel {
      top: -1.6rem;
      right: -0.4rem;
      width: 7rem;
      height: 7rem;
    }
  }

  .brand-page-intro__roundel-svg {
    width: 100%;
    height: 100%;
    animation: brand-roundel-spin 22s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-page-intro__roundel-svg {
      animation: none;
    }
  }

  .brand-page-intro__roundel-text {
    font-size: 7.3px;
    font-weight: 500;
    letter-spacing: 0.24em;
    fill: rgba(255, 255, 255, 0.82);
  }

  .brand-page-intro__roundel-center {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--green-highlight);
  }

  .brand-page-intro__caption {
    position: absolute;
    left: 1.4rem;
    bottom: 1.4rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 78%;
    padding: 0.9rem 1.2rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(14px);
    box-shadow: 0 18px 44px -20px rgba(23, 25, 28, 0.3);
  }

  .brand-page-intro__caption-tag {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green);
  }

  .brand-page-intro__caption-title {
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.3;
    color: var(--secondary);
  }

  .brand-pillar-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border-radius: 26px;
    border: 1px solid rgba(139, 197, 64, 0.14);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 22px 60px -40px rgba(47, 82, 24, 0.32);
    transition:
      transform 0.55s var(--ease-premium),
      box-shadow 0.55s var(--ease-premium),
      border-color 0.55s var(--ease-premium);
  }

  .brand-pillar-card:hover {
    transform: translateY(-6px);
    border-color: rgba(139, 197, 64, 0.32);
    box-shadow: 0 38px 88px -34px rgba(47, 82, 24, 0.4);
  }

  .brand-pillar-card__media {
    position: relative;
    height: 11.5rem;
    overflow: hidden;
  }

  /* Soft scrim so the number always reads */
  .brand-pillar-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 20, 12, 0.22) 0%,
      transparent 40%,
      rgba(10, 20, 12, 0.1) 100%
    );
    z-index: 1;
  }

  .brand-pillar-card__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92);
    transition:
      transform 1s var(--ease-premium),
      filter 1s var(--ease-premium);
  }

  .brand-pillar-card:hover .brand-pillar-card__photo {
    transform: scale(1.06);
    filter: saturate(1.05);
  }

  .brand-pillar-card__num {
    position: absolute;
    top: 0.95rem;
    right: 1.25rem;
    z-index: 2;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
  }

  .brand-pillar-card__body {
    position: relative;
    flex: 1;
    padding: 0 1.9rem 2.1rem;
  }

  /* Floating icon badge — bridges photo and content */
  .brand-pillar-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.1rem;
    height: 3.1rem;
    margin-top: -1.55rem;
    position: relative;
    z-index: 2;
    border-radius: 16px;
    color: var(--green);
    background: #fff;
    border: 1px solid rgba(139, 197, 64, 0.22);
    box-shadow: 0 14px 34px -16px rgba(47, 82, 24, 0.4);
    transition:
      background-color 0.5s var(--ease-premium),
      color 0.5s var(--ease-premium),
      transform 0.5s var(--ease-premium),
      box-shadow 0.5s var(--ease-premium);
  }

  .brand-pillar-card:hover .brand-pillar-card__icon {
    background: var(--green);
    color: #fff;
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -14px rgba(139, 197, 64, 0.55);
  }

  .brand-pillar-card__line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2.5px;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(
      90deg,
      var(--green) 0%,
      var(--green-highlight) 60%,
      transparent 100%
    );
    transition: transform 0.6s var(--ease-premium);
  }

  .brand-pillar-card:hover .brand-pillar-card__line {
    transform: scaleX(1);
  }

  .brand-partnership {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 2.5rem;
    align-items: center;
    border-radius: 32px;
    border: 1px solid rgba(168, 217, 90, 0.22);
    background:
      radial-gradient(ellipse at 88% 8%, rgba(168, 217, 90, 0.14) 0%, transparent 50%),
      radial-gradient(ellipse at 5% 95%, rgba(139, 197, 64, 0.1) 0%, transparent 45%),
      linear-gradient(135deg, #101d0c 0%, #1e3512 55%, #142410 100%);
    padding: 2.5rem 2.25rem;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 40px 100px -52px rgba(10, 20, 12, 0.75);
  }

  @media (min-width: 1024px) {
    .brand-partnership {
      grid-template-columns: 1.15fr 0.85fr;
      padding: 3.5rem;
      gap: 3.75rem;
    }
  }

  /* Oversized ghost brand word — editorial depth */
  .brand-partnership__ghost {
    position: absolute;
    right: -1.2rem;
    bottom: -2.8rem;
    z-index: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(5rem, 12vw, 9.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.04);
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
  }

  .brand-partnership__highlight {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    font-size: 0.92rem;
    font-weight: 300;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
  }

  .brand-partnership__check {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.1rem;
    border-radius: 999px;
    border: 1px solid rgba(168, 217, 90, 0.45);
    background: rgba(168, 217, 90, 0.1);
    color: var(--green-highlight);
    transition:
      background-color 0.4s var(--ease-premium),
      color 0.4s var(--ease-premium);
  }

  .brand-partnership__highlight:hover .brand-partnership__check {
    background: var(--green);
    border-color: var(--green);
    color: #fff;
  }

  /* Stats as a joined 2×2 glass grid with hairline dividers */
  .brand-partnership__stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 26px 64px -40px rgba(0, 0, 0, 0.5);
  }

  .brand-stat-cell {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.6rem 1.5rem;
    transition: background-color 0.4s var(--ease-premium);
  }

  .brand-stat-cell:hover {
    background: rgba(168, 217, 90, 0.08);
  }

  .brand-stat-cell:nth-child(even) {
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }

  .brand-stat-cell:nth-child(n + 3) {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .brand-stat-cell__value {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .brand-stat-cell__label {
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .brand-gallery {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .brand-gallery {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: 9.2rem;
      gap: 1.15rem;
    }
  }

  .brand-gallery__item {
    position: relative;
    overflow: hidden;
    margin: 0;
    border-radius: 24px;
    min-height: 260px;
    box-shadow: 0 26px 64px -42px rgba(10, 20, 12, 0.45);
  }

  /* Jewel detail — inner hairline that catches the eye on photography */
  .brand-gallery__item::after {
    content: "";
    position: absolute;
    inset: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 17px;
    pointer-events: none;
    z-index: 2;
    opacity: 0.55;
    transition: opacity 0.6s var(--ease-premium);
  }

  .brand-gallery__item:hover::after {
    opacity: 1;
  }

  /* Permanent soft scrim for depth + readability */
  .brand-gallery__item::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(10, 20, 12, 0.12) 0%,
      transparent 30%,
      transparent 55%,
      rgba(10, 20, 12, 0.42) 100%
    );
    transition: background-color 0.6s var(--ease-premium);
  }

  @media (min-width: 768px) {
    .brand-gallery__item--large {
      grid-column: span 7;
      grid-row: span 4;
      min-height: 0;
    }

    .brand-gallery__item--medium {
      grid-column: span 5;
      grid-row: span 2;
      min-height: 0;
    }

    .brand-gallery__item--wide {
      grid-column: span 8;
      grid-row: span 2;
      min-height: 0;
    }
  }

  .brand-gallery__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92);
    transition:
      transform 1.1s var(--ease-premium),
      filter 1.1s var(--ease-premium);
  }

  .brand-gallery__item:hover .brand-gallery__image {
    transform: scale(1.055);
    filter: saturate(1.06);
  }

  .brand-gallery__index {
    position: absolute;
    top: 1.15rem;
    right: 1.35rem;
    z-index: 3;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.72);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
  }

  /* Floating glass caption chip — replaces the heavy full-width gradient bar */
  .brand-gallery__caption {
    position: absolute;
    left: 1.15rem;
    bottom: 1.15rem;
    z-index: 3;
    display: inline-flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: calc(100% - 5.5rem);
    padding: 0.8rem 1.15rem;
    border-radius: 15px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(252, 251, 248, 0.88);
    backdrop-filter: blur(16px);
    box-shadow: 0 18px 44px -22px rgba(10, 20, 12, 0.5);
    transform: translateY(0);
    transition:
      transform 0.6s var(--ease-premium),
      box-shadow 0.6s var(--ease-premium);
  }

  .brand-gallery__item:hover .brand-gallery__caption {
    transform: translateY(-3px);
    box-shadow: 0 24px 54px -24px rgba(10, 20, 12, 0.55);
  }

  .brand-gallery__tag {
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--green-soft);
  }

  .brand-gallery__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--secondary);
  }

  /* Arrow chip — appears on hover, bottom-right */
  .brand-gallery__arrow {
    position: absolute;
    right: 1.15rem;
    bottom: 1.15rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(10, 20, 12, 0.5);
    backdrop-filter: blur(12px);
    color: #fff;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.5s var(--ease-premium),
      transform 0.5s var(--ease-premium),
      background-color 0.5s var(--ease-premium);
  }

  .brand-gallery__item:hover .brand-gallery__arrow {
    opacity: 1;
    transform: translateY(0);
  }

  /* Closing CTA tile — dark green invitation card inside the grid */
  .brand-gallery__cta-tile {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 260px;
    padding: 1.8rem;
    border-radius: 24px;
    border: 1px solid rgba(168, 217, 90, 0.26);
    background:
      radial-gradient(ellipse at 85% 15%, rgba(168, 217, 90, 0.14) 0%, transparent 55%),
      linear-gradient(150deg, #16240f 0%, #2b4a17 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 26px 64px -42px rgba(10, 20, 12, 0.6);
    transition:
      transform 0.55s var(--ease-premium),
      box-shadow 0.55s var(--ease-premium),
      border-color 0.55s var(--ease-premium);
  }

  @media (min-width: 768px) {
    .brand-gallery__cta-tile {
      grid-column: span 4;
      grid-row: span 2;
      min-height: 0;
    }
  }

  .brand-gallery__cta-tile:hover {
    transform: translateY(-4px);
    border-color: rgba(168, 217, 90, 0.45);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      0 34px 80px -40px rgba(10, 20, 12, 0.7);
  }

  .brand-gallery__cta-ghost {
    position: absolute;
    right: -0.6rem;
    top: -1.6rem;
    z-index: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 7rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.045);
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
    transition: color 0.6s var(--ease-premium);
  }

  .brand-gallery__cta-tile:hover .brand-gallery__cta-ghost {
    color: rgba(255, 255, 255, 0.07);
  }

  .brand-gallery__cta-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 999px;
    border: 1px solid rgba(168, 217, 90, 0.4);
    color: var(--green-highlight);
    background: rgba(168, 217, 90, 0.08);
    transition:
      background-color 0.5s var(--ease-premium),
      color 0.5s var(--ease-premium),
      transform 0.5s var(--ease-premium);
  }

  .brand-gallery__cta-tile:hover .brand-gallery__cta-arrow {
    background: var(--green);
    border-color: var(--green);
    color: #fff;
    transform: translate(2px, -2px);
  }

  .brand-custom-band {
    position: relative;
    overflow: hidden;
    padding: 6.5rem 0;
    /* Original remote 404 — verified local showroom equivalent */
    background:
      linear-gradient(125deg, rgba(10, 20, 12, 0.96) 0%, rgba(47, 82, 24, 0.9) 100%),
      url("./assets/brands/aikuchen-showroom-1.webp")
        center / cover no-repeat;
    background-blend-mode: multiply;
    background-attachment: fixed;
  }

  @media (max-width: 767px) {
    .brand-custom-band {
      background-attachment: scroll;
      padding: 5rem 0;
    }
  }

  /* Oversized ghost word — editorial depth marker */
  .brand-custom-band__ghost {
    position: absolute;
    right: -1rem;
    bottom: -2.4rem;
    z-index: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(6rem, 16vw, 13rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.035);
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
  }

  .brand-custom-band__inner {
    max-width: 46rem;
  }

  .brand-faq__item {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(139, 197, 64, 0.12) !important;
    border-radius: 20px !important;
    margin-bottom: 0.8rem;
    padding: 0 0.5rem 0 0.15rem;
    background: rgba(255, 255, 255, 0.72);
    transition:
      border-color 0.45s var(--ease-premium),
      box-shadow 0.45s var(--ease-premium),
      background-color 0.45s var(--ease-premium),
      transform 0.45s var(--ease-premium);
  }

  /* Left accent bar — revealed when open */
  .brand-faq__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--green) 0%, var(--green-highlight) 100%);
    opacity: 0;
    transition: opacity 0.45s var(--ease-premium);
  }

  .brand-faq__item:hover {
    border-color: rgba(139, 197, 64, 0.24) !important;
    background: rgba(255, 255, 255, 0.9);
  }

  .brand-faq__item[data-state="open"] {
    border-color: rgba(139, 197, 64, 0.34) !important;
    background: #fff;
    box-shadow: 0 24px 60px -32px rgba(47, 82, 24, 0.32);
    transform: translateY(-1px);
  }

  .brand-faq__item[data-state="open"]::before {
    opacity: 1;
  }

  .brand-faq__trigger {
    gap: 0.9rem !important;
    font-family: var(--font-display) !important;
    font-size: 1.1rem !important;
    font-weight: 400 !important;
    line-height: 1.35 !important;
    color: var(--secondary) !important;
    padding: 1.3rem 1rem 1.3rem 1.3rem !important;
    text-decoration: none !important;
    transition: color 0.35s var(--ease-premium) !important;
  }

  .brand-faq__trigger:hover {
    text-decoration: none !important;
    color: var(--green-soft) !important;
  }

  /* Chevron as a circled chip that fills green when open */
  .brand-faq__trigger > svg {
    width: 2rem !important;
    height: 2rem !important;
    padding: 0.45rem;
    border-radius: 999px;
    border: 1px solid rgba(139, 197, 64, 0.28);
    background: rgba(139, 197, 64, 0.07);
    color: var(--green) !important;
    transition:
      transform 0.4s var(--ease-premium),
      background-color 0.4s var(--ease-premium),
      color 0.4s var(--ease-premium),
      border-color 0.4s var(--ease-premium) !important;
  }

  .brand-faq__item[data-state="open"] .brand-faq__trigger > svg {
    background: var(--green);
    border-color: var(--green);
    color: #fff !important;
  }

  .brand-faq__num {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--green);
    opacity: 0.55;
    transition: opacity 0.4s var(--ease-premium);
  }

  .brand-faq__item[data-state="open"] .brand-faq__num {
    opacity: 1;
  }

  .brand-faq__content {
    font-size: 0.95rem !important;
    font-weight: 300 !important;
    line-height: 1.78 !important;
    letter-spacing: 0.01em !important;
    color: var(--text-soft) !important;
    padding: 0 3.4rem 1.35rem 3.3rem !important;
  }

  /* Dark contact card — echoes the partnership panel */
  .brand-faq__contact-card {
    position: relative;
    overflow: hidden;
    margin-top: 2.25rem;
    padding: 1.75rem 1.8rem;
    border-radius: 24px;
    border: 1px solid rgba(168, 217, 90, 0.24);
    background:
      radial-gradient(ellipse at 85% 10%, rgba(168, 217, 90, 0.14) 0%, transparent 55%),
      linear-gradient(150deg, #16240f 0%, #2b4a17 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 28px 68px -40px rgba(10, 20, 12, 0.65);
  }

  .brand-faq__contact-ghost {
    position: absolute;
    right: 0.4rem;
    top: -2.6rem;
    z-index: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 8rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.05);
    user-select: none;
    pointer-events: none;
  }

  .brand-faq__contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--green-highlight);
    background: rgba(168, 217, 90, 0.1);
    border: 1px solid rgba(168, 217, 90, 0.35);
  }

  .brand-advisor-card {
    position: relative;
    overflow: hidden;
    border-radius: 26px;
    border: 1px solid rgba(139, 197, 64, 0.14);
    background: rgba(255, 255, 255, 0.92);
    padding: 2rem;
    box-shadow: 0 16px 48px -34px rgba(47, 82, 24, 0.24);
    transition:
      transform 0.5s var(--ease-premium),
      box-shadow 0.5s var(--ease-premium),
      border-color 0.5s var(--ease-premium);
  }

  .brand-advisor-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--green) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.5s var(--ease-premium);
  }

  .brand-advisor-card:hover {
    transform: translateY(-4px);
    border-color: rgba(139, 197, 64, 0.28);
    box-shadow: 0 28px 70px -30px rgba(47, 82, 24, 0.32);
  }

  .brand-advisor-card:hover::before {
    opacity: 1;
  }

  .brand-advisor-card__index {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 2.4rem;
    line-height: 1;
    color: rgba(139, 197, 64, 0.22);
  }

  .brand-advisor-card__role {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green);
  }

  .brand-advisor-card__email {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--green);
    transition: gap 0.35s var(--ease-premium);
  }

  .brand-advisor-card:hover .brand-advisor-card__email {
    gap: 0.65rem;
  }

  .brand-showroom-cta {
    position: relative;
    overflow: hidden;
    padding: 5rem 0 6rem;
    background: linear-gradient(135deg, #142010 0%, #2f5218 48%, #1a2f12 100%);
  }

  .brand-showroom-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 30%, rgba(168, 217, 90, 0.12) 0%, transparent 55%);
    pointer-events: none;
  }

  .brand-showroom-cta__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    align-items: flex-start;
    justify-content: space-between;
    border-radius: 28px;
    border: 1px solid rgba(168, 217, 90, 0.22);
    padding: 2.25rem;
    background: rgba(255, 255, 255, 0.04);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 32px 80px -40px rgba(0, 0, 0, 0.4);
  }

  @media (min-width: 768px) {
    .brand-showroom-cta__inner {
      flex-direction: row;
      align-items: center;
      padding: 3rem 3.25rem;
    }
  }

  /* ─── Brand series grid (Leicht) ─────────────────────────────── */
  .brand-series__grid {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .brand-series__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .brand-series__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .brand-series__card--featured {
      grid-column: span 2;
      min-height: 22rem;
    }
  }

  .brand-series__card {
    position: relative;
    overflow: hidden;
    border-radius: 1.35rem;
    min-height: 16rem;
    border: 1px solid rgba(139, 197, 64, 0.12);
    background: #0f1a12;
  }

  .brand-series__link {
    display: block;
    position: relative;
    height: 100%;
    min-height: inherit;
  }

  .brand-series__image {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    transition: transform 0.9s var(--ease-premium);
  }

  .brand-series__card:hover .brand-series__image {
    transform: scale(1.06);
  }

  .brand-series__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 35%, rgba(8, 14, 10, 0.88) 100%);
    pointer-events: none;
  }

  .brand-series__meta {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    padding: 1.25rem 1.35rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .brand-series__tag {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-highlight);
  }

  .brand-series__name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.15;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .brand-series__cta {
    margin-top: 0.45rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.4s var(--ease-premium),
      transform 0.4s var(--ease-premium),
      color 0.4s;
  }

  .brand-series__card:hover .brand-series__cta {
    opacity: 1;
    transform: translateY(0);
    color: var(--green-highlight);
  }

  /* ─── Catalog strip ──────────────────────────────────────────── */
  .brand-catalogs {
    display: grid;
    gap: 1.75rem;
    border-radius: 1.6rem;
    border: 1px solid rgba(139, 197, 64, 0.14);
    background: rgba(255, 255, 255, 0.55);
    padding: 1.75rem;
  }

  @media (min-width: 900px) {
    .brand-catalogs {
      grid-template-columns: 0.7fr 1.3fr;
      align-items: center;
      padding: 2rem 2.25rem;
    }
  }

  .brand-catalogs__list {
    display: grid;
    gap: 0.65rem;
  }

  @media (min-width: 640px) {
    .brand-catalogs__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .brand-catalogs__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 14px;
    border: 1px solid rgba(139, 197, 64, 0.12);
    background: rgba(255, 255, 255, 0.7);
    padding: 0.9rem 1rem;
    transition:
      border-color 0.35s,
      transform 0.35s,
      box-shadow 0.35s;
  }

  .brand-catalogs__item:hover {
    border-color: rgba(139, 197, 64, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -20px rgba(20, 40, 18, 0.35);
  }

  .brand-catalogs__title {
    display: block;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--secondary);
  }

  .brand-catalogs__subtitle {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.72rem;
    color: var(--text-soft);
  }

  /* ─── Keukens overview ───────────────────────────────────────── */
  .keukens-brand-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .keukens-brand-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .keukens-brand-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .keukens-brand-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid rgba(139, 197, 64, 0.14);
    background: rgba(255, 255, 255, 0.72);
    transition:
      transform 0.45s var(--ease-premium),
      box-shadow 0.45s var(--ease-premium),
      border-color 0.45s;
  }

  .keukens-brand-card:hover {
    transform: translateY(-4px);
    border-color: rgba(139, 197, 64, 0.35);
    box-shadow: 0 28px 60px -36px rgba(20, 40, 18, 0.45);
  }

  .keukens-brand-card__media {
    position: relative;
    height: 12.5rem;
    overflow: hidden;
  }

  .keukens-brand-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-premium);
  }

  .keukens-brand-card:hover .keukens-brand-card__image {
    transform: scale(1.05);
  }

  .keukens-brand-card__body {
    padding: 1.35rem 1.4rem 1.55rem;
  }

  .keukens-value-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.6rem;
    border: 1px solid rgba(139, 197, 64, 0.14);
    background: rgba(255, 255, 255, 0.75);
    padding: 2rem;
    color: var(--secondary);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 18px 44px -38px rgba(20, 40, 18, 0.4);
    transition:
      transform 0.5s var(--ease-premium),
      border-color 0.5s var(--ease-premium),
      box-shadow 0.5s var(--ease-premium);
  }

  .keukens-value-card:hover {
    transform: translateY(-4px);
    border-color: rgba(139, 197, 64, 0.3);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 30px 64px -34px rgba(20, 40, 18, 0.48);
  }

  /* Faint oversized index anchors the corner */
  .keukens-value-card::after {
    content: "";
    position: absolute;
    right: -2.2rem;
    top: -2.2rem;
    width: 7rem;
    height: 7rem;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(139, 197, 64, 0.1) 0%, transparent 68%);
    pointer-events: none;
  }

  .keukens-value-card--dark {
    background: linear-gradient(145deg, #142010 0%, #2a4718 100%);
    border-color: rgba(168, 217, 90, 0.2);
    color: #fff;
  }

  .keukens-value-card__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 2rem;
    line-height: 1;
    color: var(--green);
  }

  .keukens-value-card--dark .keukens-value-card__num {
    color: var(--green-highlight);
  }

  /* Global heading color would otherwise win over the card's white text */
  .keukens-value-card--dark h3 {
    color: #fff;
  }

  .keukens-value-card--dark p {
    color: rgba(255, 255, 255, 0.82);
  }

  /* ─── Apparatuur pages ───────────────────────────────────────── */

  /* Hero breadcrumb — frosted pill above the title */
  .app-crumb {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(10, 20, 12, 0.35);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .app-crumb a {
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.3s var(--ease-premium);
  }

  .app-crumb a:hover {
    color: #fff;
  }

  .app-crumb__sep {
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    background: rgba(200, 169, 107, 0.75);
  }

  .app-crumb__current {
    color: rgba(255, 255, 255, 0.92);
  }

  /* Category card — overview grid */
  .app-cat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 26px;
    border: 1px solid rgba(139, 197, 64, 0.14);
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.94) 0%,
      rgba(252, 251, 248, 0.88) 100%
    );
    box-shadow: 0 22px 60px -44px rgba(20, 40, 18, 0.4);
    transition:
      transform 0.55s var(--ease-premium),
      box-shadow 0.55s var(--ease-premium),
      border-color 0.55s var(--ease-premium);
  }

  .app-cat-card:hover {
    transform: translateY(-6px);
    border-color: rgba(139, 197, 64, 0.34);
    box-shadow: 0 40px 90px -40px rgba(20, 40, 18, 0.5);
  }

  .app-cat-card__media {
    position: relative;
    height: 13rem;
    overflow: hidden;
  }

  .app-cat-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(10, 20, 12, 0.28) 0%,
      transparent 42%,
      rgba(10, 20, 12, 0.32) 100%
    );
  }

  .app-cat-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94);
    transition:
      transform 1.1s var(--ease-premium),
      filter 1.1s var(--ease-premium);
  }

  .app-cat-card:hover .app-cat-card__image {
    transform: scale(1.07);
    filter: saturate(1.06);
  }

  /* Frosted index chip — top left of the photo */
  .app-cat-card__chip {
    position: absolute;
    top: 1rem;
    left: 1.1rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.34rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(10, 20, 12, 0.4);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.92);
  }

  .app-cat-card__chip::before {
    content: "";
    width: 0.95rem;
    height: 1px;
    background: linear-gradient(90deg, var(--green-highlight), transparent);
  }

  /* Arrow bubble — slides in on hover */
  .app-cat-card__arrow {
    position: absolute;
    right: 1.1rem;
    bottom: 1rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: #fff;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.45s var(--ease-premium),
      transform 0.45s var(--ease-premium),
      background-color 0.45s var(--ease-premium);
  }

  .app-cat-card:hover .app-cat-card__arrow {
    opacity: 1;
    transform: translateY(0);
    background: var(--green);
  }

  .app-cat-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.5rem 1.6rem 1.7rem;
  }

  .app-cat-card__tag {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green);
  }

  .app-cat-card__line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2.5px;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(
      90deg,
      var(--green) 0%,
      var(--green-highlight) 60%,
      transparent 100%
    );
    transition: transform 0.6s var(--ease-premium);
  }

  .app-cat-card:hover .app-cat-card__line {
    transform: scaleX(1);
  }

  /* Type card — taller media + frosted title bar inside the photo */
  .app-type-card {
    position: relative;
    overflow: hidden;
    border-radius: 26px;
    border: 1px solid rgba(139, 197, 64, 0.14);
    box-shadow: 0 24px 64px -44px rgba(20, 40, 18, 0.42);
    transition:
      transform 0.55s var(--ease-premium),
      box-shadow 0.55s var(--ease-premium),
      border-color 0.55s var(--ease-premium);
  }

  .app-type-card:hover {
    transform: translateY(-6px);
    border-color: rgba(139, 197, 64, 0.32);
    box-shadow: 0 42px 96px -42px rgba(20, 40, 18, 0.55);
  }

  .app-type-card__media {
    position: relative;
    aspect-ratio: 4 / 3.4;
    overflow: hidden;
  }

  .app-type-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(10, 20, 12, 0.18) 0%,
      transparent 36%,
      rgba(8, 14, 9, 0.82) 100%
    );
  }

  /* Inner hairline frame — the jewellery detail */
  .app-type-card__frame {
    position: absolute;
    inset: 0.8rem;
    z-index: 2;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 18px;
    opacity: 0.55;
    transition:
      opacity 0.55s var(--ease-premium),
      inset 0.55s var(--ease-premium);
  }

  .app-type-card:hover .app-type-card__frame {
    opacity: 1;
  }

  .app-type-card__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92);
    transition:
      transform 1.15s var(--ease-premium),
      filter 1.15s var(--ease-premium);
  }

  .app-type-card:hover .app-type-card__photo {
    transform: scale(1.07);
    filter: saturate(1.08);
  }

  .app-type-card__num {
    position: absolute;
    top: 1.35rem;
    right: 1.55rem;
    z-index: 3;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.88);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
  }

  .app-type-card__caption {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    padding: 0 1.75rem 1.6rem;
  }

  .app-type-card__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
    color: #fff;
  }

  .app-type-card__title::after {
    content: "";
    display: block;
    width: 2.2rem;
    height: 2px;
    margin-top: 0.65rem;
    background: linear-gradient(90deg, var(--green-highlight), transparent);
    transform-origin: left;
    transition: transform 0.6s var(--ease-premium);
  }

  .app-type-card:hover .app-type-card__title::after {
    transform: scaleX(1.8);
  }

  .app-type-card__body {
    margin-top: 0.8rem;
    font-size: 0.92rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
  }

  /* Brand marquee — dual rows drifting in opposite directions */
  .app-brand-marquee {
    position: relative;
    overflow: hidden;
    --marquee-gap: 1.1rem;
    padding-block: 0.35rem;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 9%, #000 91%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 9%, #000 91%, transparent 100%);
  }

  .app-brand-marquee + .app-brand-marquee {
    margin-top: 1.1rem;
  }

  .app-brand-marquee__track {
    display: flex;
    gap: var(--marquee-gap);
    width: max-content;
    animation: app-marquee 42s linear infinite;
    will-change: transform;
  }

  .app-brand-marquee--reverse .app-brand-marquee__track {
    animation-direction: reverse;
    animation-duration: 48s;
  }

  .app-brand-marquee:hover .app-brand-marquee__track {
    animation-play-state: paused;
  }

  .app-brand-marquee__item {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 13.5rem;
    height: 7.25rem;
    padding: 0 2.4rem;
    border-radius: 22px;
    border: 1px solid rgba(139, 197, 64, 0.14);
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.92) 0%,
      rgba(250, 249, 245, 0.8) 100%
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 18px 40px -34px rgba(20, 40, 18, 0.5);
    transition:
      transform 0.5s var(--ease-premium),
      border-color 0.5s var(--ease-premium),
      box-shadow 0.5s var(--ease-premium);
  }

  /* Shine sweep across the tile on hover */
  .app-brand-marquee__item::after {
    content: "";
    position: absolute;
    inset: -60% -40%;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(139, 197, 64, 0.12) 50%,
      transparent 60%
    );
    transform: translateX(-70%);
    transition: transform 0.9s var(--ease-premium);
  }

  .app-brand-marquee__item:hover {
    transform: translateY(-4px);
    border-color: rgba(139, 197, 64, 0.36);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 26px 52px -28px rgba(20, 40, 18, 0.5);
  }

  .app-brand-marquee__item:hover::after {
    transform: translateX(70%);
  }

  /* Source logos ship with generous internal whitespace, so we render
     them oversized and let object-fit keep the mark centered. */
  .app-brand-marquee__item img {
    height: 6.2rem;
    width: 11.5rem;
    object-fit: contain;
    transform: scale(1.35);
    mix-blend-mode: multiply;
    filter: grayscale(1) opacity(0.66);
    transition:
      filter 0.55s var(--ease-premium),
      transform 0.55s var(--ease-premium);
  }

  .app-brand-marquee__item:hover img {
    filter: grayscale(0) opacity(1);
    transform: scale(1.48);
  }

  @media (prefers-reduced-motion: reduce) {
    .app-brand-marquee__track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
    }
  }

  /* Brand logo tile — grayscale until hover */
  .app-brand-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 6rem;
    padding: 0 1.25rem;
    border-radius: 18px;
    border: 1px solid rgba(139, 197, 64, 0.12);
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.85) 0%,
      rgba(250, 249, 245, 0.75) 100%
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 14px 34px -30px rgba(20, 40, 18, 0.5);
    transition:
      transform 0.45s var(--ease-premium),
      border-color 0.45s var(--ease-premium),
      box-shadow 0.45s var(--ease-premium);
  }

  .app-brand-tile:hover {
    transform: translateY(-3px);
    border-color: rgba(139, 197, 64, 0.32);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 22px 44px -28px rgba(20, 40, 18, 0.5);
  }

  .app-brand-tile img {
    max-height: 2.6rem;
    width: auto;
    object-fit: contain;
    filter: grayscale(1) opacity(0.62);
    transition: filter 0.5s var(--ease-premium);
  }

  .app-brand-tile:hover img {
    filter: grayscale(0) opacity(1);
  }

  /* Brands note — editorial callout with oversized tick */
  .app-note-card {
    position: relative;
    overflow: hidden;
    margin-top: 0.5rem;
    padding: 1.4rem 1.6rem 1.4rem 1.75rem;
    border-radius: 20px;
    border: 1px solid rgba(139, 197, 64, 0.2);
    background:
      radial-gradient(ellipse at 92% 0%, rgba(139, 197, 64, 0.1) 0%, transparent 55%),
      rgba(255, 255, 255, 0.82);
  }

  .app-note-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 3px;
    border-radius: 9999px;
    background: linear-gradient(180deg, var(--green) 0%, var(--green-highlight) 100%);
  }

  .app-note-card__ghost {
    position: absolute;
    right: 0.8rem;
    bottom: -1.4rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 4.6rem;
    line-height: 1;
    color: rgba(139, 197, 64, 0.12);
    pointer-events: none;
  }

  /* Related card — dark image tile with caption overlay */
  .app-related-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 22px;
    border: 1px solid rgba(139, 197, 64, 0.14);
    aspect-ratio: 16 / 10.5;
    box-shadow: 0 22px 58px -44px rgba(20, 40, 18, 0.5);
    transition:
      transform 0.5s var(--ease-premium),
      box-shadow 0.5s var(--ease-premium),
      border-color 0.5s var(--ease-premium);
  }

  .app-related-card:hover {
    transform: translateY(-5px);
    border-color: rgba(139, 197, 64, 0.32);
    box-shadow: 0 38px 82px -40px rgba(20, 40, 18, 0.58);
  }

  .app-related-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition:
      transform 1s var(--ease-premium),
      filter 1s var(--ease-premium);
  }

  .app-related-card:hover .app-related-card__image {
    transform: scale(1.06);
    filter: saturate(1.05);
  }

  .app-related-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 30%, rgba(8, 14, 9, 0.88) 100%);
  }

  .app-related-card__caption {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 1.4rem 1.3rem;
  }

  .app-related-card__arrow {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.12);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    transition:
      background-color 0.45s var(--ease-premium),
      transform 0.45s var(--ease-premium);
  }

  .app-related-card:hover .app-related-card__arrow {
    background: var(--green);
    transform: translate(2px, -2px);
  }

  /* ─── Showroom keukens ───────────────────────────────────────── */
  .showroom-mosaic {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    grid-template-rows: 11.5rem 9.5rem 11.5rem;
    gap: 0.85rem;
  }

  .showroom-mosaic__item {
    position: relative;
    overflow: hidden;
    border-radius: 1.35rem;
    border: 1px solid rgba(139, 197, 64, 0.14);
    box-shadow: 0 22px 56px -44px rgba(20, 40, 18, 0.5);
  }

  .showroom-mosaic__item--1 {
    grid-row: 1 / 3;
  }

  .showroom-mosaic__item--2 {
    grid-column: 2;
  }

  .showroom-mosaic__item--3 {
    grid-column: 2;
  }

  .showroom-mosaic__item--4 {
    grid-column: 1;
  }

  .showroom-mosaic__item--5 {
    grid-column: 2;
  }

  .showroom-mosaic__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-premium);
  }

  .showroom-mosaic__item:hover img {
    transform: scale(1.06);
  }

  .showroom-mosaic__caption {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    z-index: 1;
    padding: 0.35rem 0.7rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(10, 20, 12, 0.42);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .showroom-gallery-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .showroom-gallery-row__item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 1.35rem;
    border: 1px solid rgba(139, 197, 64, 0.14);
  }

  .showroom-gallery-row__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-premium);
  }

  .showroom-gallery-row__item:hover img {
    transform: scale(1.05);
  }

  .showroom-gallery-row__item figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 2.4rem 1rem 0.95rem;
    background: linear-gradient(180deg, transparent 0%, rgba(8, 14, 9, 0.78) 100%);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .showroom-service-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid rgba(139, 197, 64, 0.14);
    background: rgba(255, 255, 255, 0.78);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 22px 52px -42px rgba(20, 40, 18, 0.42);
    transition:
      transform 0.5s var(--ease-premium),
      border-color 0.5s var(--ease-premium),
      box-shadow 0.5s var(--ease-premium);
  }

  .showroom-service-card:hover {
    transform: translateY(-5px);
    border-color: rgba(139, 197, 64, 0.32);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 34px 70px -36px rgba(20, 40, 18, 0.52);
  }

  .showroom-service-card__media {
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .showroom-service-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-premium);
  }

  .showroom-service-card:hover .showroom-service-card__media img {
    transform: scale(1.06);
  }

  .showroom-service-card__body {
    padding: 1.25rem 1.3rem 1.4rem;
  }

  .showroom-service-card__arrow {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9999px;
    border: 1px solid rgba(139, 197, 64, 0.22);
    color: var(--green);
    transition:
      background-color 0.4s var(--ease-premium),
      color 0.4s var(--ease-premium),
      transform 0.4s var(--ease-premium);
  }

  .showroom-service-card:hover .showroom-service-card__arrow {
    background: var(--green);
    color: #fff;
    transform: translate(2px, -2px);
  }

  .showroom-quote {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid rgba(139, 197, 64, 0.14);
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.94) 0%,
      rgba(252, 251, 248, 0.86) 100%
    );
    padding: 1.7rem 1.5rem 1.6rem;
    box-shadow: 0 22px 56px -44px rgba(20, 40, 18, 0.42);
  }

  .showroom-quote__icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--green);
    opacity: 0.7;
  }

  .showroom-quote__text {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.55;
    color: var(--secondary);
  }

  .showroom-quote__name {
    margin-top: 1.25rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green);
  }

  /* ─── Editorial chapter marker (Subsector-inspired) ───────────── */
  .chapter-mark {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 2.75rem;
  }

  .chapter-mark__label {
    flex-shrink: 0;
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--green);
  }

  .chapter-mark--sentence .chapter-mark__label {
    letter-spacing: 0.08em;
    text-transform: none;
  }

  .chapter-mark__kitchen-emblem {
    position: relative;
    display: grid;
    width: 2.15rem;
    height: 2.15rem;
    flex-shrink: 0;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(139, 197, 64, 0.24);
    border-radius: 11px;
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.78), transparent 42%),
      linear-gradient(145deg, rgba(139, 197, 64, 0.09), rgba(200, 169, 107, 0.08));
    color: var(--green);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.62),
      0 10px 24px -18px rgba(47, 82, 24, 0.58);
  }

  .chapter-mark__kitchen-emblem::after {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px solid rgba(200, 169, 107, 0.16);
    border-radius: 7px;
    pointer-events: none;
  }

  .chapter-mark__kitchen-emblem svg {
    position: relative;
    z-index: 1;
    width: 1.24rem;
    height: 1.24rem;
    filter: drop-shadow(0 3px 7px rgba(47, 82, 24, 0.22));
  }

  .chapter-mark__kitchen-glow {
    position: absolute;
    inset: 15%;
    border-radius: 999px;
    background: rgba(139, 197, 64, 0.18);
    filter: blur(7px);
  }

  .chapter-mark__spacer {
    flex: 1;
  }

  .chapter-mark__num {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-style: italic;
    letter-spacing: 0.06em;
    color: var(--secondary);
  }

  .chapter-mark__total {
    font-size: 0.72rem;
    color: rgba(23, 25, 28, 0.38);
  }

  .chapter-mark--light .chapter-mark__label {
    color: var(--green-highlight);
  }

  .chapter-mark--light .chapter-mark__kitchen-emblem {
    border-color: rgba(200, 169, 107, 0.3);
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.12), transparent 42%),
      linear-gradient(145deg, rgba(139, 197, 64, 0.11), rgba(200, 169, 107, 0.08));
    color: #d8be87;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 12px 26px -17px rgba(0, 0, 0, 0.72);
  }

  .chapter-mark--light .chapter-mark__kitchen-emblem::after {
    border-color: rgba(255, 255, 255, 0.08);
  }

  .chapter-mark--light .chapter-mark__num {
    color: rgba(255, 255, 255, 0.92);
  }

  .chapter-mark--light .chapter-mark__total {
    color: rgba(255, 255, 255, 0.4);
  }

  .kitchen-eyebrow-mark {
    position: relative;
    display: inline-grid;
    width: 1.85rem;
    height: 1.6rem;
    flex-shrink: 0;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(200, 169, 107, 0.28);
    border-radius: 8px;
    background:
      radial-gradient(circle at 28% 18%, rgba(255, 255, 255, 0.18), transparent 42%),
      linear-gradient(145deg, rgba(200, 169, 107, 0.1), rgba(139, 197, 64, 0.06));
    color: #c8a96b;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 8px 18px -14px rgba(200, 169, 107, 0.72);
  }

  .kitchen-eyebrow-mark::before {
    content: "";
    width: 1.15rem;
    height: 0.86rem;
    background: currentColor;
    -webkit-mask: url("data:image/svg+xml,%3Csvg viewBox='0 0 28 20' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='14' cy='3.1' r='1.5' fill='none' stroke='black' stroke-width='1.6'/%3E%3Cpath d='M4.6 14.2C4.6 9 8.8 5.6 14 5.6s9.4 3.4 9.4 8.6M2.2 16.6h23.6' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round'/%3E%3C/svg%3E")
      center / contain no-repeat;
    mask: url("data:image/svg+xml,%3Csvg viewBox='0 0 28 20' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='14' cy='3.1' r='1.5' fill='none' stroke='black' stroke-width='1.6'/%3E%3Cpath d='M4.6 14.2C4.6 9 8.8 5.6 14 5.6s9.4 3.4 9.4 8.6M2.2 16.6h23.6' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round'/%3E%3C/svg%3E")
      center / contain no-repeat;
    filter: drop-shadow(0 2px 5px rgba(200, 169, 107, 0.28));
  }

  @media (max-width: 640px) {
    .chapter-mark {
      gap: 0.6rem;
      margin-bottom: 1.75rem;
    }

    .chapter-mark__label {
      font-size: 0.56rem;
      letter-spacing: 0.22em;
    }

    .chapter-mark__num {
      font-size: 0.85rem;
    }

    .chapter-mark__kitchen-emblem {
      width: 1.9rem;
      height: 1.9rem;
      border-radius: 9px;
    }

    .chapter-mark__kitchen-emblem svg {
      width: 1.08rem;
      height: 1.08rem;
    }
  }

  /* ─── Premium partners — light editorial bento scene ──────────── */

  /* Moody dark gallery canvas — the "chapter break" between light sections */
  .brands-scene {
    background: linear-gradient(180deg, #0d0f0a 0%, #12140e 52%, #0c0e09 100%);
  }

  /* AI showroom photograph — dimmed to a quiet cinematic backdrop */
  .brands-scene__photo {
    position: absolute;
    inset: 0;
    background-position: center 60%;
    background-size: cover;
    background-repeat: no-repeat;
    pointer-events: none;
  }

  .brands-scene__photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(13, 15, 10, 0.94) 0%,
        rgba(13, 15, 10, 0.66) 42%,
        rgba(13, 15, 10, 0.9) 100%
      ),
      radial-gradient(75% 60% at 50% 42%, transparent 30%, rgba(13, 15, 10, 0.55) 100%);
  }

  /* One quiet ambient glow — no movement */
  .brands-scene__aurora {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(720px 420px at 50% 10%, rgba(139, 197, 64, 0.08), transparent 68%),
      radial-gradient(640px 420px at 82% 85%, rgba(200, 169, 107, 0.05), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  .brands-headline-accent {
    background: linear-gradient(100deg, var(--green-soft), var(--green) 55%, #73a832);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ── Editorial brand index (Museum Index layout) ─────── */
  .index-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(200, 169, 107, 0.2);
  }

  .index-row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.1rem;
    padding: 1.4rem 1.4rem 1.4rem 0.4rem;
    border-bottom: 1px solid rgba(245, 242, 236, 0.09);
    isolation: isolate;
    transition:
      padding 0.5s var(--ease-premium),
      border-color 0.5s var(--ease-premium);
  }

  /* Warm champagne wash that sweeps in on hover */
  .index-row::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 14px;
    background: linear-gradient(
      100deg,
      rgba(200, 169, 107, 0.13) 0%,
      rgba(200, 169, 107, 0.04) 46%,
      transparent 82%
    );
    opacity: 0;
    transform: scaleX(0.96);
    transform-origin: left center;
    transition:
      opacity 0.5s var(--ease-premium),
      transform 0.5s var(--ease-premium);
  }

  .index-row:hover::before,
  .index-row:focus-within::before {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (min-width: 768px) {
    .index-row:hover,
    .index-row:focus-within {
      padding-left: 1.2rem;
      padding-right: 1.6rem;
      border-color: rgba(200, 169, 107, 0.3);
    }
  }

  .index-row__num {
    align-self: start;
    padding-top: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(200, 169, 107, 0.5);
    transition: color 0.45s var(--ease-premium);
  }

  .index-row:hover .index-row__num {
    color: var(--gold);
  }

  .index-row__body {
    min-width: 0;
  }

  .index-row__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.85rem;
  }

  .index-row__name {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: rgba(245, 242, 236, 0.9);
    transition:
      color 0.45s var(--ease-premium),
      transform 0.45s var(--ease-premium);
  }

  .index-row:hover .index-row__name {
    color: #fff;
    transform: translateX(4px);
  }

  .index-row__tag {
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
    font-size: 0.82rem;
    font-weight: 300;
    line-height: 1.5;
    color: rgba(245, 242, 236, 0.55);
    opacity: 0;
    transform: translateX(0);
    transition:
      max-height 0.5s var(--ease-premium),
      margin-top 0.5s var(--ease-premium),
      opacity 0.45s var(--ease-premium),
      transform 0.45s var(--ease-premium);
  }

  .index-row:hover .index-row__tag,
  .index-row:focus-within .index-row__tag {
    max-height: 3rem;
    margin-top: 0.55rem;
    opacity: 1;
    transform: translateX(4px);
  }

  .index-row__aside {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    min-height: 1.6rem;
  }

  .index-row__meta {
    font-family: var(--font-ui);
    font-size: 0.58rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    white-space: nowrap;
    color: rgba(245, 242, 236, 0.42);
    transition: opacity 0.4s var(--ease-premium);
  }

  .index-row:hover .index-row__meta,
  .index-row:focus-within .index-row__meta {
    opacity: 0;
  }

  /* Logo slides in over the meta label on hover (imprint via brand-logo-color) */
  .index-row .index-row__logo {
    position: absolute;
    right: 0;
    height: 1.5rem;
    max-width: 118px;
    object-fit: contain;
    opacity: 0;
    transform: translateX(14px);
    pointer-events: none;
    transition:
      opacity 0.45s var(--ease-premium),
      transform 0.45s var(--ease-premium),
      filter 0.45s var(--ease-premium);
  }

  .index-row:hover .index-row__logo,
  .index-row:focus-within .index-row__logo {
    opacity: 0.8;
    transform: translateX(0);
  }

  .index-row__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: 9999px;
    border: 1px solid rgba(245, 242, 236, 0.16);
    color: rgba(245, 242, 236, 0.5);
    font-size: 0.85rem;
    transition:
      transform 0.45s var(--ease-premium),
      border-color 0.45s var(--ease-premium),
      background-color 0.45s var(--ease-premium),
      color 0.45s var(--ease-premium),
      opacity 0.45s var(--ease-premium);
  }

  .index-row:hover .index-row__arrow,
  .index-row:focus-within .index-row__arrow {
    transform: translateX(3px);
    border-color: rgba(200, 169, 107, 0.55);
    background-color: rgba(200, 169, 107, 0.14);
    color: var(--gold);
  }

  /* Non-linked rows (appliances) — arrow stays a quiet marker */
  div.index-row .index-row__arrow {
    opacity: 0.28;
  }

  div.index-row:hover .index-row__arrow {
    transform: none;
    border-color: rgba(245, 242, 236, 0.16);
    background-color: transparent;
    color: rgba(245, 242, 236, 0.5);
  }

  /* ── Featured row — LEICHT gets a champagne frame ─────── */
  .index-row--featured {
    margin-bottom: 0.5rem;
    padding: 1.7rem 1.5rem;
    border: 1px solid rgba(200, 169, 107, 0.3);
    border-radius: 18px;
    background: linear-gradient(
      150deg,
      rgba(255, 255, 255, 0.06) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
    box-shadow:
      0 30px 70px -46px rgba(0, 0, 0, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .index-row--featured .index-row__name {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    color: #fff;
  }

  /* Featured tagline + logo are always visible */
  .index-row--featured .index-row__tag {
    max-height: 4rem;
    margin-top: 0.6rem;
    max-width: 26rem;
    opacity: 1;
  }

  .index-row--featured .index-row__meta {
    display: none;
  }

  .index-row--featured .index-row__logo {
    position: static;
    height: 2.1rem;
    max-width: 160px;
    opacity: 0.85;
    transform: none;
  }

  .index-row__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    border: 1px solid rgba(200, 169, 107, 0.4);
    background: rgba(200, 169, 107, 0.1);
    padding: 0.3rem 0.7rem;
    font-family: var(--font-ui);
    font-size: 0.56rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--gold);
  }

  .index-row__badge-dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 9999px;
    background: var(--gold);
    box-shadow: 0 0 8px rgba(200, 169, 107, 0.6);
  }

  @media (max-width: 767px) {
    .index-row:not(.index-row--featured) .index-row__aside {
      display: none;
    }

    .index-row:not(.index-row--featured) .index-row__tag {
      max-height: 3rem;
      margin-top: 0.4rem;
      opacity: 1;
    }
  }

  .group:hover .brand-tile--featured {
    transform: none;
  }

  /* Wordmark logos on dark cards — uniform pale imprints, brighten on hover */
  .brand-logo-color {
    opacity: 0.68;
    filter: grayscale(1) invert(1) brightness(1.85);
    transition:
      opacity 0.45s var(--ease-premium),
      filter 0.45s var(--ease-premium),
      transform 0.45s var(--ease-premium);
  }

  .group:hover .brand-logo-color {
    opacity: 1;
    filter: grayscale(1) invert(1) brightness(2.2);
    transform: scale(1.05);
  }

  /* Badge logos (solid colour block, e.g. Miele / AI Küchen) keep their colours */
  .brand-logo-badge {
    border-radius: 6px;
    opacity: 0.9;
    box-shadow: 0 8px 26px -12px rgba(0, 0, 0, 0.55);
    transition:
      opacity 0.45s var(--ease-premium),
      transform 0.45s var(--ease-premium);
  }

  .group:hover .brand-logo-badge {
    opacity: 1;
    transform: scale(1.05);
  }

  /* Ghost logos on the dark canvas — uniform pale imprints */
  .brands-marquee__item .brand-logo-color,
  .brands-marquee__item .brand-logo-badge {
    opacity: 0.38;
    filter: grayscale(1) invert(1) brightness(1.7);
    transition:
      opacity 0.4s var(--ease-premium),
      filter 0.4s var(--ease-premium);
  }

  .brands-marquee__item:hover .brand-logo-color,
  .brands-marquee__item:hover .brand-logo-badge {
    opacity: 0.8;
    filter: grayscale(1) invert(1) brightness(2);
  }

  /* Ghost logo marquee at the base of the scene */
  .brands-marquee {
    position: relative;
    overflow: visible;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding-block: 1.6rem;
  }

  .brands-marquee::before,
  .brands-marquee::after {
    content: "";
    position: absolute;
    z-index: 20;
    inset-block: 0;
    width: 12%;
    pointer-events: none;
  }

  .brands-marquee::before {
    left: 0;
    background: linear-gradient(90deg, #0d0f0a, transparent);
  }

  .brands-marquee::after {
    right: 0;
    background: linear-gradient(270deg, #0d0f0a, transparent);
  }

  .brands-marquee__track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: kc-scroll-x 42s linear infinite;
  }

  .brands-marquee:hover .brands-marquee__track {
    animation-play-state: paused;
  }

  .brands-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 2.75rem;
    padding-inline: 1.4rem;
  }

  .brands-marquee__item .brand-logo-white {
    opacity: 0.28;
    filter: grayscale(0.75);
    transition:
      opacity 0.4s var(--ease-premium),
      filter 0.4s var(--ease-premium);
  }

  .brands-marquee__item:hover .brand-logo-white {
    opacity: 0.8;
    filter: none;
  }

  .brands-marquee__dot {
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 9999px;
    background: rgba(200, 169, 107, 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .brands-marquee__track {
      animation: none;
    }
  }

  /* Technical figure chip — small frosted annotation over imagery */
  .fig-chip {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(10, 20, 12, 0.45);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    font-family: var(--font-ui);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    pointer-events: none;
  }

  .fig-chip__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: var(--green-highlight);
    box-shadow: 0 0 0 3px rgba(139, 197, 64, 0.24);
  }

  @media (max-width: 1024px) {
    .showroom-mosaic {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 12rem 10rem 12rem;
    }

    .showroom-gallery-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .showroom-mosaic {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .showroom-mosaic__item--1,
    .showroom-mosaic__item--2,
    .showroom-mosaic__item--3,
    .showroom-mosaic__item--4,
    .showroom-mosaic__item--5 {
      grid-column: 1;
      grid-row: auto;
      aspect-ratio: 16 / 11;
    }

    .showroom-gallery-row {
      grid-template-columns: 1fr 1fr;
      gap: 0.7rem;
    }
  }
}

/* ─── Global mobile polish ──────────────────────────────────────── */
* {
  -webkit-tap-highlight-color: transparent;
}

a,
button,
[role="button"],
input,
select,
textarea,
label {
  touch-action: manipulation;
}

@media (max-width: 767px) {
  .brand-green-button:active {
    transform: translate3d(0, 1px, 0) scale(0.985);
    transition-property: transform;
    transition-duration: 80ms;
  }

  .nav-mobile-cta:active {
    transform: translate3d(0, 1px, 0) scale(0.985);
    transition-property: transform;
    transition-duration: 80ms;
  }
}

/* Journey premium scene */
.journey-premium-scene__grain {
  background-image:
    radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.08), transparent 35%),
    radial-gradient(circle at 80% 0%, rgba(200, 169, 107, 0.06), transparent 30%),
    url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/%3E%3C/svg%3E");
  mix-blend-mode: soft-light;
}

.journey-premium-mockup-shell {
  position: relative;
}

.journey-premium-badge {
  letter-spacing: 0.1em;
}

@media (prefers-reduced-motion: reduce) {
  .journey-premium-mockup-shell,
  .journey-premium-caption,
  .journey-premium-feature {
    transition: none !important;
  }
}
